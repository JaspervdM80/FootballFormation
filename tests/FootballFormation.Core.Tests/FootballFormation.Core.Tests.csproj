<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Microsoft.NET.Test.Sdk used to set this; Directory.Build.props keys the wall-clock ban off it. -->
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <!-- xUnit1051 wants TestContext.Current.CancellationToken threaded through every EF call.
         These tests run against an in-memory SQLite database in milliseconds; the token would be
         noise on hundreds of call sites and buy no responsiveness. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.MTP" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FootballFormation.Core\FootballFormation.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
