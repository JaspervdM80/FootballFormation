@page "/login"
@using FootballFormation.Web.Email
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.Extensions.Localization
@inject NavigationManager Navigation
@inject EmailConfiguration Email
@inject IStringLocalizer<FootballFormation.UI.Strings> L
@attribute [AllowAnonymous]

<PageTitle>@L["Login"]</PageTitle>

<AuthCard Title="@L["Admin Login"]" Subtitle="@L["Sign in to manage formations"]">
    @if (_throttled)
    {
        <div class="inline-notice inline-notice-error" style="text-align: center;" role="alert">
            @L["Too many sign-in attempts. Wait a minute and try again."]
        </div>
    }
    else if (_showError)
    {
        <div class="inline-notice inline-notice-error" style="text-align: center;" role="alert">
            @L["Invalid username or password"]
        </div>
    }
    else if (_reset)
    {
        <div class="inline-notice inline-notice-success" style="text-align: center;" role="status">
            @L["Your password is set. Sign in with it now."]
        </div>
    }

    <form method="post" action="/auth/login" data-enhance="false">
        <AntiforgeryToken />
        <input type="hidden" name="returnUrl" value="@_returnUrl" />

        <div class="auth-field">
            <label for="login-username">@L["Username"]</label>
            <input id="login-username" type="text" name="username" required autocomplete="username" autofocus />
        </div>

        <div class="auth-field">
            <label for="login-password">@L["Password"]</label>
            <input id="login-password" type="password" name="password" required autocomplete="current-password" />
        </div>

        <button type="submit" class="auth-submit">@L["Sign In"]</button>
    </form>

    <div class="auth-links">
        @if (Email.IsConfigured)
        {
            <a href="@AppRoutes.ForgotPassword">@L["Forgot your password?"]</a>
        }
        <a href="@AppRoutes.Home">@L["Continue as viewer"]</a>
    </div>
</AuthCard>

@code {
    private bool _showError;
    private bool _throttled;
    private bool _reset;
    private string _returnUrl = "";

    protected override void OnInitialized()
    {
        var uri = new Uri(Navigation.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        _showError = query.ContainsKey("error");
        _throttled = query.TryGetValue("error", out var error) && error == "throttled";
        _reset = query.ContainsKey("reset");
        if (query.TryGetValue("returnUrl", out var returnUrl))
            _returnUrl = returnUrl.ToString();
    }
}
