@page "/forgot-password"
@using FootballFormation.Web.Email
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.Extensions.Localization
@inject NavigationManager Navigation
@inject EmailConfiguration Email
@inject IStringLocalizer<FootballFormation.UI.Strings> L
@attribute [AllowAnonymous]

<PageTitle>@L["Forgot your password?"]</PageTitle>

<AuthCard Title="@L["Forgot your password?"]" Subtitle="@L["Enter the email address of your account and we'll mail you a link to choose a new one."]">
    @if (!Email.IsConfigured)
    {
        <div class="inline-notice inline-notice-warning" style="text-align: center;" role="status">
            @L["Mail is not set up here. Ask an administrator for a sign-in link."]
        </div>
    }
    else if (_throttled)
    {
        <div class="inline-notice inline-notice-error" style="text-align: center;" role="alert">
            @L["Too many attempts. Wait a minute and try again."]
        </div>
    }
    else if (_sent)
    {
        @* The same words whether or not an account uses the address, or this would tell a stranger which ones do. *@
        <div class="inline-notice inline-notice-success" style="text-align: center;" role="status">
            @L["If an account uses that address, a link is on its way. Check your inbox in a minute."]
        </div>
    }

    @if (Email.IsConfigured)
    {
        <form method="post" action="/auth/forgot-password" data-enhance="false">
            <AntiforgeryToken />

            <div class="auth-field">
                <label for="forgot-email">@L["Email"]</label>
                <input id="forgot-email" type="email" name="email" required autocomplete="email" autofocus />
            </div>

            <button type="submit" class="auth-submit">@L["Send link"]</button>
        </form>
    }

    <div class="auth-links">
        <a href="@AppRoutes.Login">@L["Back to sign in"]</a>
    </div>
</AuthCard>

@code {
    private bool _sent;
    private bool _throttled;

    protected override void OnInitialized()
    {
        var query = QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query);
        _sent = query.ContainsKey("sent");
        _throttled = query.TryGetValue("error", out var error) && error == "throttled";
    }
}
