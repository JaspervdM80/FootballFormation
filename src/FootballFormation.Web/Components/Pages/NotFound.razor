@page "/not-found"
@using FootballFormation.UI.Layout
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<FootballFormation.UI.Strings> L
@layout MainLayout

<PageTitle>@L["Page Not Found"]</PageTitle>

<MudText Typo="Typo.h4">@L["Page Not Found"]</MudText>
<MudText Typo="Typo.body1">@L["Sorry, the content you are looking for does not exist."]</MudText>
<MudButton Href="@AppRoutes.Home" Variant="Variant.Text" Color="Color.Primary" Class="mt-4">@L["Start"]</MudButton>
