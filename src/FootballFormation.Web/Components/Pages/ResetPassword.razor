@page "/reset-password"
@using FootballFormation.Web.Email
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.Extensions.Localization
@inject NavigationManager Navigation
@inject PasswordLinkService Links
@inject EmailConfiguration Email
@inject IStringLocalizer<FootballFormation.UI.Strings> L
@attribute [AllowAnonymous]

<PageTitle>@L["Choose a password"]</PageTitle>

@* The token is in this page's address, so nothing it links to or loads may be told where it came from. *@
<HeadContent>
    <meta name="referrer" content="no-referrer" />
</HeadContent>

<AuthCard Title="@L["Choose a password"]" Subtitle="@L["Pick the password you will sign in with from now on."]">
    @if (_throttled)
    {
        @* The limiter answers before the form is read, so the token is gone; the mail still has it. *@
        <div class="inline-notice inline-notice-error" style="text-align: center;" role="alert">
            @L["Too many attempts. Wait a minute and open the link again."]
        </div>
    }
    else if (!_usable)
    {
        <div class="inline-notice inline-notice-error" style="text-align: center;" role="alert">
            @L["This link has expired or has already been used"]
        </div>
    }
    else
    {
        @if (_error is { } error)
        {
            <div class="inline-notice inline-notice-error" style="text-align: center;" role="alert">@error</div>
        }

        <form method="post" action="/auth/reset-password" data-enhance="false">
            <AntiforgeryToken />
            <input type="hidden" name="token" value="@_token" />

            <div class="auth-field">
                <label for="reset-password">@L["New Password"]</label>
                <input id="reset-password" type="password" name="password" required autocomplete="new-password"
                       minlength="@UserService.MinPasswordLength" autofocus />
            </div>

            <div class="auth-field">
                <label for="reset-confirm">@L["Confirm password"]</label>
                <input id="reset-confirm" type="password" name="confirm" required autocomplete="new-password"
                       minlength="@UserService.MinPasswordLength" />
            </div>

            <button type="submit" class="auth-submit">@L["Save password"]</button>
        </form>
    }

    <div class="auth-links">
        @if (!_usable && !_throttled && Email.IsConfigured)
        {
            <a href="@AppRoutes.ForgotPassword">@L["Send me a new link"]</a>
        }
        <a href="@AppRoutes.Login">@L["Back to sign in"]</a>
    </div>
</AuthCard>

@code {
    private string _token = string.Empty;
    private bool _usable;
    private bool _throttled;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        var query = QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query);
        _token = query.TryGetValue("token", out var token) ? token.ToString() : string.Empty;

        var result = await Links.IsUsableAsync(_token);
        _usable = result is { IsSuccess: true, Value: true };

        if (!query.TryGetValue("error", out var error)) return;

        _throttled = error == "throttled";

        _error = error.ToString() switch
        {
            "mismatch" => L["Passwords do not match"].Value,
            "short" => L["Password must be at least {0} characters", UserService.MinPasswordLength].Value,
            _ => L["Something went wrong. Try again."].Value
        };
    }
}
