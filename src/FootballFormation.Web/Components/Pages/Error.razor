@page "/Error"
@using System.Diagnostics
@using FootballFormation.UI.Layout
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<FootballFormation.UI.Strings> L
@layout MainLayout

@* Not the ASP.NET template, whose "Swapping to Development environment" paragraph is developer instructions shown to Dutch-speaking
   parents. The request id stays: it matches a line in the Serilog file, which is what makes a report actionable. *@

<PageTitle>@L["Something went wrong"]</PageTitle>

<MudPaper Class="pa-6 mt-6" MaxWidth="500px" Elevation="2" Style="border-radius: 16px;">
    <MudText Typo="Typo.h5" GutterBottom="true">@L["Something went wrong"]</MudText>
    <MudText Typo="Typo.body1" Class="mb-4">
        @L["The page could not be loaded. Try again, and if it keeps happening let the administrator know."]
    </MudText>

    @if (ShowRequestId)
    {
        <MudText Typo="Typo.caption" Style="color: var(--ink-muted);">
            @L["Reference"]: <code>@RequestId</code>
        </MudText>
    }

    <MudButton Href="@AppRoutes.Home" Variant="Variant.Filled" Class="btn-gold mt-4" FullWidth="true">
        @L["Start"]
    </MudButton>
</MudPaper>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
