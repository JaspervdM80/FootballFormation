@using Microsoft.Extensions.Localization
@inject IStringLocalizer<FootballFormation.UI.Strings> L
@inject FootballFormation.UI.State.TeamState Team
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <base href="/" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="@Team.DisplayName" />
    <link rel="manifest" href="manifest.webmanifest" />
    <link rel="apple-touch-icon" href="icons/icon-180.png" />
    <ResourcePreloader />
    @* Through Assets[], not its plain path: only the fingerprinted route is served `immutable`,
       which is all service-worker.js will cache. At 611KB this is most of the app's weight. *@
    <link href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" rel="stylesheet" />
    @* Inline and first, so every stylesheet below can read the tokens. The values are compile-time constants in ClubTheme — nothing
       user-supplied reaches this markup. *@
    <style>@(new MarkupString(FootballFormation.UI.Theming.ClubTheme.Current.ToCssVariables()))</style>
    <link rel="stylesheet" href="@Assets["theme.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["FootballFormation.Web.styles.css"]" />
    <link rel="preload" href="fonts/dm-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    @* No render mode here: each page declares its own, and the ones that do not are served as plain HTML with no circuit to lose when a
       phone suspends the app. See docs/known_issues/touch-pwa.md. *@
    <Routes />
    @* Blazor toggles the classes on this element; styled dark in app.css and
       auto-reloaded by pwa.js so resuming a suspended phone app just works. *@
    <div id="components-reconnect-modal">@L["Reconnecting..."]</div>
    @* Blazor unhides this when a circuit hits an unhandled error; without the element a broken page just goes quiet. Reloading is the
       only recovery, so the whole bar is the button. *@
    <div id="blazor-error-ui">
        <span>@L["Something went wrong. Reload the page to continue."]</span>
        <a href="" class="reload">@L["Reload"]</a>
    </div>
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
    <script src="js/screenshot.js"></script>
    <script src="js/clipboard.js"></script>
    <script src="js/drag-drop-touch.js"></script>
    <script src="js/pwa.js"></script>
    @* Started by hand because the retry schedule below cannot be set any other way, and inline rather than a file under js/ because with
       autostart="false" a script that fails to arrive leaves the page rendered, correct-looking and permanently inert. *@
    <script src="@Assets["_framework/blazor.web.js"]" autostart="false"></script>
    <script>
        // The stock schedule burns all ten immediate attempts in the fraction of a second a resuming phone has no radio, so every return
        // started from the five-second bucket. maxRetries covers the ten minutes Program.cs holds a circuit for — see touch-pwa.md.
        Blazor.start({
            circuit: {
                reconnectionOptions: {
                    maxRetries: 136,
                    retryIntervalMilliseconds: previousAttempts =>
                        previousAttempts === 0 ? 0 : previousAttempts < 20 ? 1000 : 5000
                }
            }
        });
    </script>
</body>

</html>

@code {
    // The head renders before MainLayout, so this is what runs the one team query the whole request then shares.
    protected override Task OnInitializedAsync() => Team.EnsureLoadedAsync();
}
