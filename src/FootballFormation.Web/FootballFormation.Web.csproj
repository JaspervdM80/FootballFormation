<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- Pre-compile assemblies to avoid JIT lag on first render of each component -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FootballFormation.Core\FootballFormation.Core.csproj" />
    <ProjectReference Include="..\FootballFormation.UI\FootballFormation.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- EntityFrameworkCore.Design belongs to Core, which hosts DesignTimeDbContextFactory and is
         the only project the migration commands need to be pointed at. A second reference here
         did nothing. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="MudBlazor" />
    <PackageReference Include="Serilog.AspNetCore" />
  </ItemGroup>

</Project>
