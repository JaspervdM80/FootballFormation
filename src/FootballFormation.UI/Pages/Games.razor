@page "/games"
@inherits SeasonAwarePage
@rendermode InteractiveServer

@* See InteractiveShell: the providers and the session gate this page no longer inherits, because
   the layout renders statically. *@
<InteractiveShell />

<PageTitle>@L["Games"]</PageTitle>

<PageHeader Class="mb-6" Title="@L["Games"]">
    <SubtitleContent>
        <MudText Typo="Typo.body2" Class="page-header-subtitle">
            @if (_games is not null)
            {
                @(_games.Count == 1 ? L["{0} match", _games.Count] : L["{0} matches", _games.Count])
                @if (SeasonState.SelectedSeason is { } season)
                {
                    <span> · @season.Name</span>
                }
                var incomplete = _games.Count(IsIncomplete);
                if (incomplete > 0)
                {
                    <span class="header-warning"> · @L["{0} without lineup", incomplete]</span>
                }
            }
        </MudText>
    </SubtitleContent>
    <Actions>
        <AuthorizeView Roles="@AppRoles.Admin">
            <MudButton Variant="Variant.Filled" Class="btn-gold btn-compact" StartIcon="@Icons.Material.Filled.Add"
                       OnClick="OpenAddDialog">
                @L["Add"]
            </MudButton>
        </AuthorizeView>
    </Actions>
</PageHeader>

@if (_games is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_games.Count == 0)
{
    <MudPaper Class="pa-6" Elevation="2" Style="border-radius: 16px; text-align: center;">
        <MudIcon Icon="@Icons.Material.Filled.SportsSoccer" Size="Size.Large" Style="color: var(--ink-faint);" />
        <MudText Typo="Typo.body1" Class="mt-3" Style="color: var(--ink-muted);">
            @(SeasonState.SelectedSeason is { } season
                ? L["No games in {0} yet.", season.Name]
                : L["No games yet. Create your first game!"])
        </MudText>
    </MudPaper>
}
else
{
    @foreach (var gameList in Sections())
    {
        <div class="game-section">
            <div class="card-label">@gameList.Title</div>
            <div class="game-cards">
                @foreach (var game in gameList.Games)
                {
                    @* Left-edge stripe marks the venue (home/away); an amber tint marks a played game with no lineup. *@
                    var rowClass = game.IsHomeGame ? "home" : "away";
                    if (IsIncomplete(game)) rowClass += " no-lineup";
                    <div class="game-row @rowClass" @onclick="() => OpenGame(game)">
                        <div class="game-primary">
                            <div class="game-meta">
                                <span class="game-date">@game.Date.ToString("dd MMM")</span>
                                @if (IsIncomplete(game))
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.WarningAmber" Size="Size.Small" Class="nolineup-icon"
                                             Title="@L["This game has no lineup — playing time can't be recorded"]" />
                                }
                            </div>
                            @* Same venue badge the player statistics use, for the same reason: the
                               edge stripe is a colour and colour alone never said which venue. *@
                            <span class="game-opponent">@game.Opponent<VenueBadge IsHome="game.IsHomeGame" Inline="true" /></span>
                        </div>
                        @* No badge for a competition match — that is the norm, and one on every card is
                           noise. A cup tie or a practice game changes what the row means, so it says so. *@
                        @if (game.MatchType != MatchType.Competition)
                        {
                            <span class="badge-teal">@L[game.MatchType.DisplayName()]</span>
                        }
                        <span class="badge-gold">@game.FormationType.DisplayName()</span>
                        @if (game.UnavailablePlayerIds.Count > 0)
                        {
                            <span class="badge-unavailable">@L["{0} out", game.UnavailablePlayerIds.Count]</span>
                        }
                        @if (game.GuestPlayerIds.Count > 0)
                        {
                            <span class="badge-guest">@L["+{0} guest", game.GuestPlayerIds.Count]</span>
                        }
                        @if (game.ScoreHome.HasValue && game.ScoreAway.HasValue)
                        {
                            var scoreClass = game.ScoreHome > game.ScoreAway ? "win" : game.ScoreHome < game.ScoreAway ? "loss" : "draw";
                            @* Scoreboard reads in venue order: the home side is listed first. *@
                            var left = game.IsHomeGame ? game.ScoreHome : game.ScoreAway;
                            var right = game.IsHomeGame ? game.ScoreAway : game.ScoreHome;
                            <span class="game-score @scoreClass">@left – @right</span>
                        }
                        <div class="game-actions" @onclick:stopPropagation="true">
                            @* Live leads the row and wears the red wherever it appears; the extra class
                               only adds the pulse. A match in progress is what everyone wants first, so it
                               is not admin-gated, and it stays reachable whatever the calendar says.
                               Otherwise the live screen is a match-day tool. Once the score is final there
                               is nothing left to run, so the icon goes and Result is the way in. *@
                            @if (game.MatchState == MatchState.InProgress)
                            {
                                <button class="action-btn action-live action-live-now" title="@L["Live"]" @onclick="() => OpenLive(game.Id)">
                                    <MudIcon Icon="@Icons.Material.Filled.Sensors" Size="Size.Small" />
                                </button>
                            }
                            else if (IsMatchDay(game) && !HasFinalScore(game))
                            {
                                <AuthorizeView Roles="@AppRoles.Admin">
                                    <button class="action-btn action-live" title="@L["Live"]" @onclick="() => OpenLive(game.Id)">
                                        <MudIcon Icon="@Icons.Material.Filled.Sensors" Size="Size.Small" />
                                    </button>
                                </AuthorizeView>
                            }
                            <AuthorizeView Roles="@AppRoles.Admin">
                                @* Empty grid variant + amber tint when the lineup is missing, so a coach
                                   spots which cards need a lineup at a glance from the action row. *@
                                <button class="action-btn @(IsIncomplete(game) ? "action-needs-lineup" : "")"
                                        title="@(IsIncomplete(game) ? L["Add lineup"] : L["Formation"])"
                                        @onclick="() => OpenFormation(game.Id)">
                                    <MudIcon Icon="@(IsIncomplete(game) ? Icons.Material.Outlined.GridView : Icons.Material.Filled.ViewModule)" Size="Size.Small" />
                                </button>
                            </AuthorizeView>
                            <button class="action-btn" title="@L["Overview"]" @onclick="() => OpenOverview(game.Id)">
                                <MudIcon Icon="@Icons.Material.Filled.Share" Size="Size.Small" />
                            </button>
                            @* A match still to be played has no result to look at and none to enter. *@
                            @if (!IsFuture(game))
                            {
                                <button class="action-btn" title="@L["Result"]" @onclick="() => OpenResult(game.Id)">
                                    <MudIcon Icon="@Icons.Material.Filled.Scoreboard" Size="Size.Small" />
                                </button>
                            }
                            <AuthorizeView Roles="@AppRoles.Admin">
                                <button class="action-btn" title="@L["Edit"]" @onclick="() => OpenEditDialog(game)">
                                    <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" />
                                </button>
                                <button class="action-btn action-delete" title="@L["Delete"]" @onclick="() => DeleteGame(game)">
                                    <MudIcon Icon="@Icons.Material.Filled.Delete" Size="Size.Small" />
                                </button>
                            </AuthorizeView>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
}
