@page "/games"
@inject IStringLocalizer<Strings> L

<PageTitle>@L["Games"]</PageTitle>

@* Only an admin has anything to do here that needs a circuit; the parents reading the fixtures get plain HTML and no socket to lose. *@
<AuthorizeView Roles="@AppRoles.Admin">
    <Authorized>
        <GameBoard @rendermode="InteractiveServer" />
    </Authorized>
    <NotAuthorized>
        <GameBoard />
    </NotAuthorized>
</AuthorizeView>
