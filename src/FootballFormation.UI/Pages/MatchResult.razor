@page "/games/{GameId:int}/result"
@inherits CancellableComponent

<PageTitle>@L["Match Result"]</PageTitle>

@if (GameData is null || AllPlayers is null)
{
    <MudProgressCircular Indeterminate="true" />
    return;
}

@* The opponent name repeats in the score card below; on mobile it is hidden to save space —
   .result-opponent and .result-subtitle live in app.css, since PageHeader renders those elements. *@
<PageHeader BackFallback="@AppRoutes.Games" TitleTypo="Typo.h5"
            Class="mb-2 result-header" TitleClass="result-opponent"
            Title="@($"{(GameData.IsHomeGame ? "vs" : "@")} {GameData.Opponent}")">
    <SubtitleContent>
        <MudText Typo="Typo.body2" Class="result-subtitle">
            @GameData.Date.ToString("dd MMMM yyyy") · @(GameData.IsHomeGame ? L["Home"] : L["Away"]) · @L[GameData.MatchType.DisplayName()] · @GameData.FormationType.DisplayName()
        </MudText>
    </SubtitleContent>
</PageHeader>

<div class="result-layout">
    <MudPaper Class="pa-5" Elevation="2" Style="border-radius: 16px;">
        <div class="card-label">@L["Final Score"]</div>
        @{
            // ScoreHome/ScoreAway always mean "us"/"them"; only the display order follows the venue.
            RenderFragment ourSide =
                @<div class="score-side">
                    <span class="score-name">@L["Us"]</span>
                    <AuthorizeView Roles="@AppRoles.Admin" Context="auth">
                        <Authorized>
                            <input type="number" class="score-big-input" min="0" max="99"
                                   value="@ScoreHome"
                                   @onchange="e => ScoreHome = string.IsNullOrEmpty(e.Value?.ToString()) ? null : int.Parse(e.Value.ToString()!)" />
                        </Authorized>
                        <NotAuthorized>
                            <span class="score-big-input" style="pointer-events: none;">@(ScoreHome?.ToString() ?? "–")</span>
                        </NotAuthorized>
                    </AuthorizeView>
                </div>;
            RenderFragment opponentSide =
                @<div class="score-side">
                    <span class="score-name">@GameData.Opponent</span>
                    <AuthorizeView Roles="@AppRoles.Admin" Context="auth">
                        <Authorized>
                            <input type="number" class="score-big-input score-away" min="0" max="99"
                                   value="@ScoreAway"
                                   @onchange="e => ScoreAway = string.IsNullOrEmpty(e.Value?.ToString()) ? null : int.Parse(e.Value.ToString()!)" />
                        </Authorized>
                        <NotAuthorized>
                            <span class="score-big-input score-away" style="pointer-events: none;">@(ScoreAway?.ToString() ?? "–")</span>
                        </NotAuthorized>
                    </AuthorizeView>
                </div>;
        }
        <div class="score-visual">
            @(GameData.IsHomeGame ? ourSide : opponentSide)
            <span class="score-vs">–</span>
            @(GameData.IsHomeGame ? opponentSide : ourSide)
        </div>
        <AuthorizeView Roles="@AppRoles.Admin">
            <MudButton Variant="Variant.Filled" Class="btn-gold mt-4" FullWidth="true"
                       OnClick="SaveScore">
                @L["Save Score"]
            </MudButton>
        </AuthorizeView>
    </MudPaper>

    <MudPaper Class="pa-5" Elevation="2" Style="border-radius: 16px;">
        <div class="card-label">@L["Goals"] (@GameData.Goals.Count)</div>

        @if (GameData.Goals.Count > 0)
        {
            <div class="goal-timeline">
                @* Ordered on the elapsed match clock, which runs on across the break, so a goal in
                   first-half stoppage time keeps its place above the restart rather than sorting
                   past it — see GameGoal.TimelineSeconds. *@
                @foreach (var goal in GameData.Goals.OrderBy(g => g.TimelineSeconds))
                {
                    @* Own goals and opponent goals both count against us, so they share the styling. *@
                    <div class="goal-entry @(goal.IsOwnGoal || goal.IsOpponentGoal ? "own-goal" : "")">
                        <span class="goal-time">
                            @(MatchClockReport.MinuteOf(GameData, goal) is { } at ? $"{at}'" : "—")
                        </span>
                        <div class="goal-info">
                            <div class="goal-player">
                                @(goal.Scorer?.DisplayName ?? GameData.Opponent)
                                @if (goal.IsOwnGoal)
                                {
                                    <span class="own-goal-tag">(@L["OG"])</span>
                                }
                            </div>
                            @if (goal.Assister is not null)
                            {
                                <div class="goal-assist">↳ @goal.Assister.DisplayName</div>
                            }
                        </div>
                        <AuthorizeView Roles="@AppRoles.Admin">
                            <button class="goal-remove" @onclick="() => RemoveGoal(goal)">×</button>
                        </AuthorizeView>
                    </div>
                }
            </div>
        }
        else
        {
            <MudText Typo="Typo.body2" Style="color: var(--ink-subtle);" Class="mb-3">
                @L["No goals recorded yet"]
            </MudText>
        }

        <AuthorizeView Roles="@AppRoles.Admin">
            @if (!AllScorersLogged)
            {
            <div class="add-section">
                <div class="add-row">
                    <div class="field" style="width: 60px;">
                        <label>@L["Min"]</label>
                        <input type="number" min="1" max="@GameData.GameDurationMinutes"
                               value="@NewGoalMinute"
                               @onchange="e => NewGoalMinute = string.IsNullOrEmpty(e.Value?.ToString()) ? null : int.Parse(e.Value.ToString()!)" />
                    </div>
                    <div class="field" style="flex: 1; min-width: 110px;">
                        <label>@L["Scorer"]</label>
                        <select value="@(NewGoalScorerId?.ToString() ?? "")"
                                @onchange="e => NewGoalScorerId = string.IsNullOrEmpty(e.Value?.ToString()) ? null : int.Parse(e.Value.ToString()!)">
                            <option value="">@L["Select player..."]</option>
                            @foreach (var player in SquadPlayers)
                            {
                                <option value="@player.Id">
                                    <PlayerLabel Player="player" />
                                </option>
                            }
                        </select>
                    </div>
                    <div class="field" style="flex: 1; min-width: 110px;">
                        <label>@L["Assist"]</label>
                        <select value="@(NewGoalAssisterId?.ToString() ?? "")"
                                @onchange="e => NewGoalAssisterId = string.IsNullOrEmpty(e.Value?.ToString()) ? null : int.Parse(e.Value.ToString()!)">
                            <option value="">@L["Optional"]</option>
                            @foreach (var player in SquadPlayers.Where(p => p.Id != NewGoalScorerId))
                            {
                                <option value="@player.Id">
                                    <PlayerLabel Player="player" />
                                </option>
                            }
                        </select>
                    </div>
                    <div class="field og-check">
                        <label>@L["OG"]</label>
                        <input type="checkbox" @bind="NewGoalIsOwnGoal" />
                    </div>
                    <button class="btn-add-goal" disabled="@(NewGoalScorerId is null)" @onclick="AddGoal">
                        + @L["Add"]
                    </button>
                </div>
            </div>
            }
        </AuthorizeView>
    </MudPaper>

    @* An empty comments card on the public site is just clutter, so a visitor with nothing to read
       gets no card at all. Admins always get it — it is where comments are written.
       IsAdmin comes from the same place the load does, so the controls on screen can never disagree
       with what GetCommentsAsync was asked for. *@
    @if (IsAdmin || Comments.Count > 0)
    {
        <MudPaper Class="pa-5 result-comments" Elevation="2" Style="border-radius: 16px;">
            <div class="card-label">@L["Comments"] (@Comments.Count)</div>

            @if (Comments.Count > 0)
            {
                <div class="comment-list">
                    @foreach (var comment in Comments)
                    {
                        <div class="comment-entry @(comment.IsPublic ? "is-public" : "")">
                            <div class="comment-body">@comment.Body</div>
                            <div class="comment-meta">
                                <span>@comment.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</span>
                                @if (comment.EditedAt is not null)
                                {
                                    <span>· @L["edited"]</span>
                                }
                                @if (IsAdmin)
                                {
                                    @if (comment.Author is not null)
                                    {
                                        <span>· @comment.Author.DisplayName</span>
                                    }
                                    <span class="comment-visibility @(comment.IsPublic ? "is-public" : "")">
                                        @(comment.IsPublic ? L["Public"] : L["Admin only"])
                                    </span>
                                }
                            </div>
                            @if (IsAdmin)
                            {
                                <div class="comment-actions">
                                    <button class="comment-btn"
                                            title="@(comment.IsPublic ? L["Make admin only"] : L["Publish"])"
                                            @onclick="() => ToggleCommentVisibility(comment)">
                                        <MudIcon Size="Size.Small"
                                                 Icon="@(comment.IsPublic ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)" />
                                    </button>
                                    <button class="goal-remove" title="@L["Delete"]"
                                            @onclick="() => RemoveComment(comment)">×</button>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <MudText Typo="Typo.body2" Style="color: var(--ink-subtle);" Class="mb-3">
                    @L["No comments yet"]
                </MudText>
            }

            @if (IsAdmin)
            {
                <div class="add-section">
                    <MudTextField @bind-Value="NewCommentBody" Label="@L["Add comment"]" Lines="3"
                                  Immediate="true" Class="mb-2" />
                    @* Off by default: publishing is always a deliberate act. *@
                    <div class="comment-add-row">
                        <MudSwitch @bind-Value="NewCommentIsPublic" Color="Color.Primary" Class="ma-0"
                                   Label="@L["Visible to everyone"]" />
                        <button class="btn-add-goal" disabled="@string.IsNullOrWhiteSpace(NewCommentBody)"
                                @onclick="AddComment">
                            + @L["Add"]
                        </button>
                    </div>
                </div>
            }
        </MudPaper>
    }
</div>
