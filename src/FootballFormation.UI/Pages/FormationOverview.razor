@page "/games/{GameId:int}/overview"
@inherits CancellableComponent

<PageTitle>@L["Formation Overview"]</PageTitle>

@if (GameData is null)
{
    <MudProgressCircular Indeterminate="true" />
    return;
}

@* Outside .overview-capture on purpose: that area is what gets screenshotted, and a back button has no business in the shared image.
   No subtitle either, because the capture block below already names the fixture and the date. *@
<PageHeader Title="@L["Formation Overview"]" TitleTypo="Typo.h6" Class="mb-3"
            BackFallback="@BackFallback" />

<div class="overview-capture" id="formation-overview">
    <div class="overview-header">
        <div class="overview-header-left">
            <span class="overview-title">@GameData.Opponent<VenueBadge IsHome="GameData.IsHomeGame" Inline="true" /></span>
            @* This image gets shared, so a cup tie or a practice game has to be legible in it.
               A competition match is the norm and stays unlabelled. *@
            <span class="overview-date">
                @GameData.DateLine("dd MMM yyyy")@if (GameData.MatchType != MatchType.Competition)
                {
                    <text> · </text>@L[GameData.MatchType.DisplayName()]
                }
            </span>
            <span class="overview-formation">@L[GameData.FormationType.DisplayName()]</span>
        </div>
    </div>

    @if (GameData.HasLineup)
    {
        <div class="overview-periods">
            @foreach (var period in GameData.Periods.OrderBy(p => p.PeriodType))
            {
                var formation = period.FormationTypeOverride ?? GameData.FormationType;
                var lineup = PeriodLineups.GetValueOrDefault(period.Id, []);
                var starters = lineup.Where(p => !p.IsSubstitute).ToList();
                var subs = lineup.Where(p => p.IsSubstitute).ToList();

                <div class="overview-period-card">
                    <div class="period-label">@L[period.PeriodType.DisplayName()]</div>
                    <Pitch Formation="formation" Positions="starters" HidePositionFit="IsAnonymous" />
                    @if (subs.Count > 0)
                    {
                        <div class="subs-row">
                            <span class="subs-label">@L["Subs"]:</span>
                            @foreach (var sub in subs)
                            {
                                <span class="sub-badge">
                                    @if (sub.Player?.ShirtNumber is not null)
                                    {
                                        <span class="sub-number">#@sub.Player.ShirtNumber</span>
                                    }
                                    @(sub.Player?.ShortName ?? L["Player {0}", sub.PlayerId].Value)
                                </span>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="subs-row">
                            <span class="subs-label subs-none">@L["No subs"]</span>
                        </div>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <MudText Typo="Typo.body2" Style="color: var(--ink-subtle);">@L["No formation yet"]</MudText>
    }
</div>

@* A plain onclick into js/screenshot.js, not a Blazor handler: this page renders without a circuit to dispatch one to, and the script
   already takes an element id, does the download and reports its own failure. *@
<div class="overview-actions">
    <button type="button" class="btn-gold overview-capture"
            onclick="captureFormationOverview('formation-overview', 'screenshot-error')">
        <MudIcon Icon="@Icons.Material.Filled.CameraAlt" Size="Size.Small" />
        @L["Save as image"]
    </button>
    @* Same shape as the screenshot button above. *@
    @if (SummaryText is not null)
    {
        <button type="button" class="btn-gold overview-capture"
                onclick="copyElementText('match-summary-text', 'copy-success', 'copy-error')">
            <MudIcon Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" />
            @L["Copy match result"]
        </button>
    }
</div>

<div id="screenshot-error" class="inline-notice inline-notice-warning" role="alert" hidden>
    @L["Screenshot failed — try using your device's screenshot instead"]
</div>

@if (SummaryText is not null)
{
    <pre id="match-summary-text" hidden>@SummaryText</pre>
    <div id="copy-success" class="inline-notice inline-notice-success" role="status" hidden>
        @L["Copied to clipboard"]
    </div>
    <div id="copy-error" class="inline-notice inline-notice-warning" role="alert" hidden>
        @L["Couldn't copy — try again"]
    </div>
}
