@page "/games/{GameId:int}/live"
@inherits CancellableComponent
@rendermode InteractiveServer

@* See InteractiveShell: the providers and the session gate this page no longer inherits, because
   the layout renders statically. *@
<InteractiveShell />

<PageTitle>@L["Live Match"]</PageTitle>

@if (GameData is null)
{
    <MudProgressCircular Indeterminate="true" />
    return;
}

@* mb-2, not the usual mb-4: on a sideline phone every pixel above the scoreboard counts. *@
@* The opponent's name stands on its own: the subtitle already says which ground it is on, so a
   "vs"/"@" in front of it only repeats that in punctuation. *@
<PageHeader BackFallback="@AppRoutes.Games" TitleTypo="Typo.h6" Class="mb-2"
            Title="@GameData.Opponent"
            Subtitle="@($"{GameData.DateLine("dd MMM yyyy")} · {(GameData.IsHomeGame ? L["Home"] : L["Away"])}")" />

<div class="live-layout">
    <MudPaper Class="pa-4 live-scoreboard" Elevation="2">
        @{
            // ScoreHome/ScoreAway always mean "us"/"them"; only the display order follows the venue.
            RenderFragment ourSide =
                @<div class="live-score-side">
                    <span class="live-score-name">@L["Us"]</span>
                    <span class="live-score-value">@(GameData.ScoreHome ?? 0)</span>
                </div>;
            RenderFragment theirSide =
                @<div class="live-score-side">
                    <span class="live-score-name">@GameData.Opponent</span>
                    <span class="live-score-value live-score-away">@(GameData.ScoreAway ?? 0)</span>
                </div>;
        }
        <div class="live-score-row">
            @(GameData.IsHomeGame ? ourSide : theirSide)
            <span class="live-score-dash">–</span>
            @(GameData.IsHomeGame ? theirSide : ourSide)
        </div>

        @* The clock stops at the end of the half; anything past it is counted alongside rather
           than rolled into the reading, the way a scoreboard shows 30:00 +2:15. *@
        <div class="live-clock">
            @ClockDisplay
            @if (Clock.IsInAdditionalTime)
            {
                <span class="live-clock-extra">+@AdditionalDisplay</span>
            }
        </div>
        <div class="@StatusCssClass">@StatusLabel</div>
    </MudPaper>

    @* Kick-off is the only thing there is to do before a match, so it stays under the scoreboard.
       Everything the clock does afterwards is pressed once a half at most and lives at the foot of
       the page instead — see .live-controls below. *@
    @if (GameData.MatchState == MatchState.NotStarted)
    {
        <AuthorizeView Roles="@AppRoles.Admin">
            <MudPaper Class="pa-3 live-controls" Elevation="2">
                <MudButton Variant="Variant.Filled" Class="btn-gold" FullWidth="true" Size="Size.Large"
                           StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="StartMatch">
                    @L["Start match"]
                </MudButton>
            </MudPaper>
        </AuthorizeView>
    }

    @* No line-up for this half means an empty pitch and an empty bench, which says nothing the
       formation screens are not already there to fix — the card stays away until someone is on it.
       .live-lineup drops it below the timeline on a phone — see app.css. *@
    @if (DisplayLineup.Count > 0)
    {
        <MudPaper Class="pa-4 live-lineup" Elevation="2" Style="border-radius: 16px;">
            @* The half's name and, for the coach only, the way into what the plan still holds for it.
               The button carries the count so the plan can be ignored at a glance when it is empty. *@
            <div class="live-card-head">
                <div class="card-label">
                    @(DisplayHalfLabel is { } half ? L[half] : L["Line-up"])
                </div>
                <AuthorizeView Roles="@AppRoles.Admin">
                    @if (PlannedChangeCount > 0)
                    {
                        <MudButton Variant="Variant.Outlined" Class="btn-ghost live-plan-btn" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.SwapHoriz" OnClick="ShowPlannedChanges">
                            @L["Changes ({0})", PlannedChangeCount]
                        </MudButton>
                    }
                </AuthorizeView>
            </div>

            @if (CanSubstitute)
            {
                <MudText Typo="Typo.caption" Class="live-pitch-hint">
                    @L["Tap a player to substitute them, change their position, or mark them injured."]
                </MudText>
            }

            @* OnPlayerClicked is left unset for spectators and at half time, which keeps the pitch inert. *@
            <Pitch Formation="DisplayFormation" Positions="OnPitch"
                   HidePositionFit="!_isAdmin"
                   OnPlayerClicked="@(CanSubstitute ? EventCallback.Factory.Create<int>(this, OpenSubDialog) : default)" />

            <div class="live-bench">
                <span class="live-bench-label">@L["Subs"]:</span>
                @if (OnBench.Count == 0)
                {
                    <span class="live-bench-empty">@L["No subs"]</span>
                }
                else
                {
                    @foreach (var sub in OnBench)
                    {
                        <span class="live-bench-chip">
                            @if (sub.Player?.ShirtNumber is not null)
                            {
                                <span class="live-bench-number">#@sub.Player.ShirtNumber</span>
                            }
                            @PlayerLabel(sub.PlayerId)
                        </span>
                    }
                }
            </div>
        </MudPaper>
    }

    @* Nothing is scored before kick-off or after the final whistle, so the buttons stay out of the
       way entirely rather than sitting there greyed out. A goal missed at the time is added back on
       /result, which is where a finished match is corrected. *@
    @if (GameData.MatchState == MatchState.InProgress)
    {
        <AuthorizeView Roles="@AppRoles.Admin">
            <div class="live-actions">
                <MudButton Variant="Variant.Filled" Class="btn-gold live-action-btn" Size="Size.Large"
                           StartIcon="@Icons.Material.Filled.SportsSoccer" OnClick="AddGoal">
                    @L["Goal"]
                </MudButton>
                <MudButton Variant="Variant.Outlined" Class="btn-ghost live-action-btn" Size="Size.Large"
                           OnClick="AddOpponentGoal">
                    @L["Goal against"]
                </MudButton>
            </div>
        </AuthorizeView>
    }

    <MudPaper Class="pa-4" Elevation="2" Style="border-radius: 16px;">
        @* Rotation fills this list with swaps nobody is scrolling back for, so they fold away and
           leave the goals on their own. The toggle rides the heading rather than sitting under it:
           it is a setting for the list, not the first thing in it. *@
        <div class="live-card-head">
            <div class="card-label">@L["Timeline"]</div>
            <div class="live-timeline-toggle">
                <MudCheckBox T="bool" @bind-Value="ShowSubstitutions" Dense="true" Size="Size.Small" Color="Color.Primary">
                    @L["Show substitutions"]
                </MudCheckBox>
            </div>
        </div>

        @if (Timeline.Count == 0)
        {
            @* Two different emptinesses, and saying "nothing has happened" during a match with
               three substitutions in it would be the checkbox's doing, not the truth. *@
            <MudText Typo="Typo.body2" Style="color: var(--ink-subtle);">
                @(HasEvents ? L["No goals yet"] : L["Nothing has happened yet"])
            </MudText>
        }
        else
        {
            <div class="live-timeline">
                @foreach (var entry in Timeline)
                {
                    @* The list runs newest first, so the break lands between the second half's
                       events and the first's — the only thing on the timeline that is not
                       something somebody did. *@
                    @if (entry.HalfTimeAbove)
                    {
                        <div class="live-event-break">@L["Half time"]</div>
                    }

                    var against = entry.Goal is { } g && (g.IsOwnGoal || g.IsOpponentGoal);
                    <div class="live-event @(against ? "live-event-against" : "")">
                        <span class="live-event-min">@(entry.Minute is { } at ? $"{at}'" : "—")</span>
                        <MudIcon Size="Size.Small" Icon="@EventIcon(entry)"
                                 Class="@(entry.Injury is not null ? "live-event-injury" : null)"
                                 Title="@(entry.Injury is not null ? L["Injured"].Value : null)" />
                        <div class="live-event-body">
                            @if (entry.Goal is { } goal)
                            {
                                <div class="live-event-main">
                                    @(goal.Scorer?.DisplayName ?? GameData.Opponent)
                                    @if (goal.IsOwnGoal)
                                    {
                                        <span class="live-event-tag">(@L["OG"])</span>
                                    }
                                </div>
                                @if (goal.Assister is not null)
                                {
                                    <div class="live-event-sub">↳ @goal.Assister.DisplayName</div>
                                }
                            }
                            else if (entry.Substitution is { } sub)
                            {
                                <div class="live-event-main">@PlayerLabel(sub.PlayerOnId)</div>
                                <div class="live-event-sub">↔ @PlayerLabel(sub.PlayerOffId)</div>
                            }
                            else if (entry.Injury is { } injury)
                            {
                                @* Only ever an injury nobody came on for. *@
                                <div class="live-event-main">@PlayerLabel(injury.PlayerId)</div>
                                <div class="live-event-sub">@L["Off injured, not replaced"]</div>
                            }
                        </div>
                        @* The score the goal made it, in the scoreboard's order. Reading it off the
                           list is otherwise impossible: the list runs backwards. *@
                        @if (entry.Score is { } score)
                        {
                            <span class="live-event-score">@ScoreText(score)</span>
                        }
                        <AuthorizeView Roles="@AppRoles.Admin" Context="auth">
                            @if (entry.Goal is { } goalToRemove)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                               title="@L["Remove"]"
                                               OnClick="() => RemoveGoal(goalToRemove)" />
                            }
                            else if (entry.Substitution is { } subToRemove)
                            {
                                @* This also drops any injury recorded with it — one tap made both. *@
                                <MudIconButton Icon="@Icons.Material.Filled.Undo" Size="Size.Small"
                                               title="@L["Undo"]"
                                               OnClick="() => RemoveSubstitution(subToRemove)" />
                            }
                            else if (entry.Injury is { } injuryToRemove)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Undo" Size="Size.Small"
                                               title="@L["Undo"]"
                                               OnClick="() => RemoveInjury(injuryToRemove)" />
                            }
                        </AuthorizeView>
                    </div>
                }
            </div>
        }
    </MudPaper>

    @* Nobody selected anywhere in the match means every row would be a name-less zero, so the card
       is left out entirely rather than headed over an empty table. *@
    @if (MinutesPlayed.Count > 0)
    {
        <AuthorizeView Roles="@AppRoles.Admin">
            <MudPaper Class="pa-4 live-minutes-card" Elevation="2" Style="border-radius: 16px;">
                @* Before kick-off these are the minutes the line-up plans for, not minutes anyone has
                   played — the heading says which, because the numbers themselves cannot. *@
                <div class="card-label">@(MinutesAreActual ? L["Minutes played"] : L["Planned minutes"])</div>

                <div class="live-minutes">
                    @foreach (var row in MinutesPlayed)
                    {
                        <div class="live-minutes-row @(row.IsOnPitch ? "live-minutes-on" : "")">
                            @if (row.Player.ShirtNumber is not null)
                            {
                                <span class="live-minutes-number">#@row.Player.ShirtNumber</span>
                            }
                            <span class="live-minutes-name">@row.Player.DisplayName</span>
                            @if (row.IsOnPitch)
                            {
                                <span class="live-minutes-dot" title="@L["On the pitch"]"></span>
                            }
                            <span class="live-minutes-value">@row.Minutes'</span>
                        </div>
                    }
                </div>
            </MudPaper>
        </AuthorizeView>
    }

    @* The end of a half, of the match, and the way on to the result screen. Each is pressed once
       and nothing above it can be reached past it, so they sit at the foot of the page rather than
       between the scoreboard and the buttons that are pressed all match. *@
    @if (GameData.MatchState != MatchState.NotStarted)
    {
        <AuthorizeView Roles="@AppRoles.Admin">
            <MudPaper Class="pa-3 live-controls live-controls-foot" Elevation="2">
                @if (GameData.MatchState == MatchState.InProgress)
                {
                    <div class="live-control-row">
                        @* The clock knows halves only. The line-up change partway through a half is
                           made by hand from the pitch, so it has no control of its own here — it is a
                           reference, behind the button on the line-up card. *@
                        @if (HalfTimeFollows)
                        {
                            <MudButton Variant="Variant.Filled" Class="btn-gold"
                                       StartIcon="@Icons.Material.Filled.SportsScore" OnClick="EndHalf">
                                @L["Half time"]
                            </MudButton>
                        }
                        else if (!IsHalfInPlay && NextHalfLabel is { } startingNext)
                        {
                            <MudButton Variant="Variant.Filled" Class="btn-gold"
                                       StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="StartNextHalf">
                                @L["Start {0}", L[startingNext]]
                            </MudButton>
                        }

                        <MudButton Variant="Variant.Outlined" Class="btn-ghost"
                                   StartIcon="@Icons.Material.Filled.Flag" OnClick="FinishMatch">
                            @L["Finish match"]
                        </MudButton>
                    </div>
                }
                else
                {
                    <MudButton Variant="Variant.Filled" Class="btn-gold" FullWidth="true"
                               StartIcon="@Icons.Material.Filled.EditNote" OnClick="NavigateToResult">
                        @L["Edit result"]
                    </MudButton>
                }
            </MudPaper>
        </AuthorizeView>
    }
</div>
