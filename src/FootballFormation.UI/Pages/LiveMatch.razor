@page "/games/{GameId:int}/live"
@inherits CancellableComponent

<PageTitle>@L["Live Match"]</PageTitle>

@if (GameData is null)
{
    <MudProgressCircular Indeterminate="true" />
    return;
}

@* mb-2, not the usual mb-4: on a sideline phone every pixel above the scoreboard counts. *@
<PageHeader BackFallback="@AppRoutes.Games" TitleTypo="Typo.h6" Class="mb-2"
            Title="@($"{(GameData.IsHomeGame ? "vs" : "@")} {GameData.Opponent}")"
            Subtitle="@($"{GameData.Date:dd MMM yyyy} · {(GameData.IsHomeGame ? L["Home"] : L["Away"])}")" />

<div class="live-layout">
    <MudPaper Class="pa-4 live-scoreboard" Elevation="2">
        @{
            // ScoreHome/ScoreAway always mean "us"/"them"; only the display order follows the venue.
            RenderFragment ourSide =
                @<div class="live-score-side">
                    <span class="live-score-name">@L["Us"]</span>
                    <span class="live-score-value">@(GameData.ScoreHome ?? 0)</span>
                </div>;
            RenderFragment theirSide =
                @<div class="live-score-side">
                    <span class="live-score-name">@GameData.Opponent</span>
                    <span class="live-score-value live-score-away">@(GameData.ScoreAway ?? 0)</span>
                </div>;
        }
        <div class="live-score-row">
            @(GameData.IsHomeGame ? ourSide : theirSide)
            <span class="live-score-dash">–</span>
            @(GameData.IsHomeGame ? theirSide : ourSide)
        </div>

        @* The clock stops at the end of the half; anything past it is counted alongside rather
           than rolled into the reading, the way a scoreboard shows 30:00 +2:15. *@
        <div class="live-clock">
            @ClockDisplay
            @if (Clock.IsInAdditionalTime)
            {
                <span class="live-clock-extra">+@AdditionalDisplay</span>
            }
        </div>
        <div class="@StatusCssClass">@StatusLabel</div>
    </MudPaper>

    <AuthorizeView Roles="@AppRoles.Admin">
        <MudPaper Class="pa-3 live-controls" Elevation="2">
            @if (GameData.MatchState == MatchState.NotStarted)
            {
                <MudButton Variant="Variant.Filled" Class="btn-gold" FullWidth="true" Size="Size.Large"
                           StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="StartMatch">
                    @L["Start match"]
                </MudButton>
            }
            else if (GameData.MatchState == MatchState.InProgress)
            {
                <div class="live-control-row">
                    @if (IsLivePeriod)
                    {
                        @* A quarter boundary is not a stoppage, it is the planned line-up change
                           partway through the half — so it is named after what it does. *@
                        @if (BreakFollowsCurrentPeriod)
                        {
                            <MudButton Variant="Variant.Filled" Class="btn-gold"
                                       StartIcon="@Icons.Material.Filled.SportsScore" OnClick="EndPeriod">
                                @L["Half time"]
                            </MudButton>
                        }
                        else if (MidHalfSuccessor is not null)
                        {
                            <MudButton Variant="Variant.Filled" Class="btn-gold"
                                       StartIcon="@Icons.Material.Filled.SwapHoriz" OnClick="AdvancePeriod">
                                @L["Next line-up"]
                            </MudButton>
                        }
                    }
                    else if (NextHalfLabel is { } startingNext)
                    {
                        <MudButton Variant="Variant.Filled" Class="btn-gold"
                                   StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="StartNextPeriod">
                            @L["Start {0}", L[startingNext]]
                        </MudButton>
                    }

                    <MudButton Variant="Variant.Outlined" Class="btn-ghost"
                               StartIcon="@Icons.Material.Filled.Flag" OnClick="FinishMatch">
                        @L["Finish match"]
                    </MudButton>
                </div>
            }
            else
            {
                <MudButton Variant="Variant.Filled" Class="btn-gold" FullWidth="true"
                           StartIcon="@Icons.Material.Filled.EditNote" OnClick="NavigateToResult">
                    @L["Edit result"]
                </MudButton>
            }
        </MudPaper>
    </AuthorizeView>

    @* .live-lineup drops this card below the timeline on a phone — see app.css. *@
    <MudPaper Class="pa-4 live-lineup" Elevation="2" Style="border-radius: 16px;">
        <div class="card-label">
            @(DisplayHalfLabel is { } half ? L[half] : L["Line-up"])
        </div>

        @if (DisplayLineup.Count == 0)
        {
            <MudText Typo="Typo.body2" Style="color: var(--ink-subtle);">
                @L["No line-up for this period yet — build one first."]
            </MudText>
        }
        else
        {
            @if (CanSubstitute)
            {
                <MudText Typo="Typo.caption" Class="live-pitch-hint">
                    @L["Tap a player to substitute them or change their position."]
                </MudText>
            }

            @* OnPlayerClicked is left unset for spectators and between periods, which keeps the pitch inert. *@
            <Pitch Formation="DisplayFormation" Positions="OnPitch"
                   HidePositionFit="!_isAdmin"
                   OnPlayerClicked="@(CanSubstitute ? EventCallback.Factory.Create<int>(this, OpenSubDialog) : default)" />

            @* The bench is reference material, not something to act on, so it can be folded away
               to keep the pitch and the controls on one phone screen. *@
            <div class="live-bench-toggle">
                <MudCheckBox T="bool" @bind-Value="ShowSubs" Dense="true" Size="Size.Small" Color="Color.Primary">
                    @L["Show subs"]
                </MudCheckBox>
            </div>

            @if (ShowSubs)
            {
                <div class="live-bench">
                    <span class="live-bench-label">@L["Subs"]:</span>
                    @if (OnBench.Count == 0)
                    {
                        <span class="live-bench-empty">@L["No subs"]</span>
                    }
                    else
                    {
                        @foreach (var sub in OnBench)
                        {
                            <span class="live-bench-chip">
                                @if (sub.Player?.ShirtNumber is not null)
                                {
                                    <span class="live-bench-number">#@sub.Player.ShirtNumber</span>
                                }
                                @PlayerLabel(sub.PlayerId)
                            </span>
                        }
                    }
                </div>
            }
        }
    </MudPaper>

    @* The quarters the line-up was planned in are never named on this screen, but the difference
       between them is exactly the set of changes due halfway through the half — which is the part
       worth knowing at the touchline. Measured against the pitch as it stands, so a swap already
       made live disappears from the list.
       Admin only, like the minutes table: this is what the coach is about to do, not what has
       happened, and a plan on a shared screen invites being asked about before it is carried out. *@
    <AuthorizeView Roles="@AppRoles.Admin">
        @{ var planned = PlannedChanges; }
        @if (!planned.IsEmpty)
        {
            <MudPaper Class="pa-4" Elevation="2" Style="border-radius: 16px;">
                <div class="card-label">@L["Changes at half-way"]</div>
                <div class="live-planned">
                    @foreach (var change in planned.Substitutions)
                    {
                        <div class="live-planned-row">
                            <span class="live-planned-pos">@change.Position.ToString()</span>
                            <span class="live-planned-off">@(change.PlayerOff?.ShortName ?? "—")</span>
                            @* Plain text, not a MudIcon: scoped CSS never reaches a child component's root element. *@
                            <span class="live-planned-arrow">→</span>
                            <span class="live-planned-on">@(change.PlayerOn?.ShortName ?? "—")</span>
                        </div>
                    }
                </div>

                @* Secondary: nobody leaves the pitch, so this never competes with the swaps above. *@
                @if (planned.Moves.Count > 0)
                {
                    <div class="live-planned-moves">
                        <span class="live-planned-moves-label">@L["Position changes"]</span>
                        @foreach (var move in planned.Moves)
                        {
                            <span class="live-planned-move">
                                @move.Player.ShortName
                                <span class="live-planned-move-pos">@move.From.ToString() → @move.To.ToString()</span>
                            </span>
                        }
                    </div>
                }
            </MudPaper>
        }
    </AuthorizeView>

    @* Nothing can be scored before kick-off, so the buttons stay out of the way entirely
       rather than sitting there greyed out above the start button. *@
    @if (GameData.MatchState != MatchState.NotStarted)
    {
        <AuthorizeView Roles="@AppRoles.Admin">
            <div class="live-actions">
                <MudButton Variant="Variant.Filled" Class="btn-gold live-action-btn" Size="Size.Large"
                           StartIcon="@Icons.Material.Filled.SportsSoccer" OnClick="AddGoal">
                    @L["Goal"]
                </MudButton>
                <MudButton Variant="Variant.Outlined" Class="btn-ghost live-action-btn" Size="Size.Large"
                           OnClick="AddOpponentGoal">
                    @L["Goal against"]
                </MudButton>
            </div>
        </AuthorizeView>
    }

    <MudPaper Class="pa-4" Elevation="2" Style="border-radius: 16px;">
        <div class="card-label">@L["Timeline"]</div>

        @if (Timeline.Count == 0)
        {
            <MudText Typo="Typo.body2" Style="color: var(--ink-subtle);">
                @L["Nothing has happened yet"]
            </MudText>
        }
        else
        {
            <div class="live-timeline">
                @foreach (var entry in Timeline)
                {
                    var against = entry.Goal is { } g && (g.IsOwnGoal || g.IsOpponentGoal);
                    <div class="live-event @(against ? "live-event-against" : "")">
                        <span class="live-event-min">@(entry.Minute)'</span>
                        <MudIcon Size="Size.Small"
                                 Icon="@(entry.IsGoal ? Icons.Material.Filled.SportsSoccer : Icons.Material.Filled.SwapHoriz)" />
                        <div class="live-event-body">
                            @if (entry.Goal is { } goal)
                            {
                                <div class="live-event-main">
                                    @(goal.Scorer?.DisplayName ?? GameData.Opponent)
                                    @if (goal.IsOwnGoal)
                                    {
                                        <span class="live-event-tag">(@L["OG"])</span>
                                    }
                                </div>
                                @if (goal.Assister is not null)
                                {
                                    <div class="live-event-sub">↳ @goal.Assister.DisplayName</div>
                                }
                            }
                            else if (entry.Substitution is { } sub)
                            {
                                <div class="live-event-main">@PlayerLabel(sub.PlayerOnId)</div>
                                <div class="live-event-sub">↔ @PlayerLabel(sub.PlayerOffId)</div>
                            }
                        </div>
                        @* The score the goal made it, in the scoreboard's order. Reading it off the
                           list is otherwise impossible: the list runs backwards. *@
                        @if (entry.Score is { } score)
                        {
                            <span class="live-event-score">@ScoreText(score)</span>
                        }
                        <AuthorizeView Roles="@AppRoles.Admin" Context="auth">
                            @if (entry.Goal is { } goalToRemove)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                               title="@L["Remove"]"
                                               OnClick="() => RemoveGoal(goalToRemove)" />
                            }
                            else if (entry.Substitution is { } subToRemove)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Undo" Size="Size.Small"
                                               title="@L["Undo"]"
                                               OnClick="() => RemoveSubstitution(subToRemove)" />
                            }
                        </AuthorizeView>
                    </div>
                }
            </div>
        }
    </MudPaper>

    <AuthorizeView Roles="@AppRoles.Admin">
        <MudPaper Class="pa-4 live-minutes-card" Elevation="2" Style="border-radius: 16px;">
            <div class="card-label">@L["Minutes played"]</div>

            @if (MinutesPlayed.Count == 0)
            {
                <MudText Typo="Typo.body2" Style="color: var(--ink-subtle);">
                    @L["No line-up for this period yet — build one first."]
                </MudText>
            }
            else
            {
                <div class="live-minutes">
                    @foreach (var row in MinutesPlayed)
                    {
                        <div class="live-minutes-row @(row.IsOnPitch ? "live-minutes-on" : "")">
                            @if (row.Player.ShirtNumber is not null)
                            {
                                <span class="live-minutes-number">#@row.Player.ShirtNumber</span>
                            }
                            <span class="live-minutes-name">@row.Player.DisplayName</span>
                            @if (row.IsOnPitch)
                            {
                                <span class="live-minutes-dot" title="@L["On the pitch"]"></span>
                            }
                            <span class="live-minutes-value">@row.Minutes'</span>
                        </div>
                    }
                </div>
            }
        </MudPaper>
    </AuthorizeView>
</div>
