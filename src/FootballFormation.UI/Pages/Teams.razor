@page "/teams"
@using FootballFormation.UI.Theming
@attribute [Authorize(Roles = AppRoles.ApplicationAdmin)]
@inherits CancellableComponent
@rendermode InteractiveServer

@* See InteractiveShell: the providers and the session gate this page no longer inherits, because
   the layout renders statically. *@
<InteractiveShell RequiresRole="@AppRoles.ApplicationAdmin" />

<PageTitle>@L["Teams"]</PageTitle>

<PageHeader Class="mb-6" Title="@L["Teams"]"
            Subtitle="@L["The clubs and teams this app serves."]" />

@if (_teams is null || _clubs is null)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-7" />
    return;
}

<MudPaper Class="pa-6" MaxWidth="560px" Elevation="2" Style="border-radius: 16px;">
    <div class="card-label">@L["Clubs"]</div>

    <div class="club-picker">
        <div class="club-picker-field">
            <MudSelect T="int" Value="_selectedClubId" ValueChanged="SelectClub" Label="@L["Club"]"
                       Disabled="@(_clubs.Count == 0)">
                @foreach (var club in _clubs)
                {
                    <MudSelectItem Value="club.Id">@club.Name</MudSelectItem>
                }
            </MudSelect>
        </div>
        <button class="action-btn action-add" title="@L["Add Club"]" aria-label="@L["Add Club"]"
                @onclick="OpenAddClubDialog">
            <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" />
        </button>
    </div>

    @if (SelectedClub is not { } club)
    {
        <div class="teams-empty">@L["No clubs yet. Add one to get started."]</div>
    }
    else
    {
        <div class="list-row club-summary">
            <img src="@ClubTheme.LogoFor(club)" alt="" class="club-crest" />
            <div class="list-row-info">
                <span class="list-row-name">@club.Name</span>
                @* The styles behind a theme are compiled in, so this names one rather than describing it. *@
                <span class="list-row-meta">@L["Theme {0}", club.ThemeName] · @TeamCount</span>
            </div>
            <div class="list-row-actions">
                <button class="action-btn" title="@L["Edit Club"]" aria-label="@L["Edit Club"]"
                        @onclick="() => OpenEditClubDialog(club)">
                    <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" />
                </button>
                <button class="action-btn action-delete" title="@L["Delete Club"]" aria-label="@L["Delete Club"]"
                        @onclick="() => DeleteClub(club)">
                    <MudIcon Icon="@Icons.Material.Filled.Delete" Size="Size.Small" />
                </button>
            </div>
        </div>
    }
</MudPaper>

@if (SelectedClub is not null)
{
    <MudPaper Class="pa-6 mt-6" MaxWidth="560px" Elevation="2" Style="border-radius: 16px;">
        <div class="teams-head">
            <div class="card-label">@L["Teams"]</div>
            <button class="action-btn action-add" title="@L["Add Team"]" aria-label="@L["Add Team"]"
                    @onclick="OpenAddTeamDialog">
                <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" />
            </button>
        </div>

        @if (_clubTeams.Count == 0)
        {
            <div class="teams-empty">@L["No teams in this club yet."]</div>
        }
        else
        {
            <div class="list-rows">
                @foreach (var team in _clubTeams)
                {
                    <div class="list-row">
                        <span class="list-row-name">
                            @team.Name
                            @if (team.Id == _currentTeamId)
                            {
                                <span class="badge-teal">@L["Selected"]</span>
                            }
                        </span>
                        <div class="list-row-actions">
                            @if (team.Id != _currentTeamId)
                            {
                                @* A link and a real page load, like the season picker: the team is read off the request that creates a
                                   scope, so the chrome and the page would otherwise disagree until the next navigation. *@
                                <a class="action-btn" href="@AppRoutes.SetTeam(team.Id, AppRoutes.Teams)"
                                   data-enhance-nav="false" title="@L["Show this team"]" aria-label="@L["Show this team"]">
                                    <MudIcon Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" />
                                </a>
                            }
                            <button class="action-btn" title="@L["Edit Team"]" aria-label="@L["Edit Team"]"
                                    @onclick="() => OpenEditTeamDialog(team)">
                                <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" />
                            </button>
                            <button class="action-btn action-delete" title="@L["Delete Team"]" aria-label="@L["Delete Team"]"
                                    @onclick="() => DeleteTeam(team)">
                                <MudIcon Icon="@Icons.Material.Filled.Delete" Size="Size.Small" />
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
    </MudPaper>
}
