@page "/players/{PlayerId:int}/stats"
@inherits SeasonAwarePage

<PageTitle>@(_stats is not null ? _stats.Player.DisplayName : L["Player Stats"])</PageTitle>

@if (!_loaded)
{
    <MudProgressCircular Indeterminate="true" />
    return;
}

@if (_stats is null)
{
    return;
}

<InlineNotice Notice="_notice" />

@* The squad is only the fallback: this page is reached from the season statistics just as often,
   and the back arrow follows whichever way the visitor actually came. *@
<PageHeader BackFallback="@AppRoutes.Players" TitleTypo="Typo.h5"
            Subtitle="@L[_stats.Player.PreferredPosition.DisplayName()]">
    <TitleContent>
        @if (_stats.Player.ShirtNumber is not null)
        {
            <span style="color: var(--club-primary-bright);">#@_stats.Player.ShirtNumber</span>
        }
        @_stats.Player.DisplayName
    </TitleContent>
</PageHeader>

@if (_stats.GamesPlayed == 0 && _stats.Goals == 0 && _stats.Assists == 0)
{
    <MudPaper Class="pa-6" Elevation="2" Style="border-radius: 16px; text-align: center;">
        <MudIcon Icon="@Icons.Material.Filled.QueryStats" Size="Size.Large"
                 Style="color: var(--ink-faint);" />
        <MudText Typo="Typo.body1" Class="mt-3" Style="color: var(--ink-muted);">
            @L["No games recorded yet for this player."]
        </MudText>
    </MudPaper>
    return;
}

@* Three tiles instead of four when the minutes tile is gone, or the row keeps a dead fourth column. *@
<div class="stat-tiles @(_isAdmin ? "" : "stat-tiles-3") mb-4">
    <div class="stat-tile">
        <div class="stat-value">@_stats.GamesPlayed</div>
        <div class="stat-label">@L["Games"]</div>
    </div>
    @* Every figure here is minutes, so the tile goes whole rather than hollowed out. *@
    @if (_isAdmin)
    {
        <div class="stat-tile">
            <div class="stat-value">@_stats.TotalMinutes<span class="stat-unit">'</span></div>
            <div class="stat-label">@L["Minutes"]</div>
            <div class="stat-sub">@L["{0} / game", _stats.AverageMinutes.ToString("0")]</div>
            <div class="stat-sub">@L["{0}% of {1}'", _stats.Utilization.ToString("0"), _stats.AvailableMinutes]</div>
        </div>
    }
    <div class="stat-tile">
        <div class="stat-value">@_stats.Goals</div>
        <div class="stat-label">@L["Goals"]</div>
        <div class="stat-sub">@L["{0} / game", _stats.GoalsPerGame.ToString("0.00")]</div>
    </div>
    <div class="stat-tile">
        <div class="stat-value">@_stats.Assists</div>
        <div class="stat-label">@L["Assists"]</div>
        <div class="stat-sub">@L["{0} / game", _stats.AssistsPerGame.ToString("0.00")]</div>
    </div>
</div>

<div class="stats-layout">
    <MudPaper Class="pa-5" Elevation="2" Style="border-radius: 16px;">
        <div class="card-label">@L["Positions"]</div>
        @if (_stats.Positions.Count > 0)
        {
            <div class="position-bars">
                @foreach (var pos in _stats.Positions)
                {
                    <div class="position-row">
                        <div class="position-head">
                            <span class="position-name">@L[pos.Position.DisplayName()]</span>
                            @* The share is the point of the bar and stays public; the minutes behind it do not. *@
                            <span class="position-meta">@(_isAdmin ? $"{pos.Minutes}' · " : "")@pos.Percentage.ToString("0")%</span>
                        </div>
                        <div class="position-track">
                            <div class="position-fill" style="width: @(pos.Percentage.ToString(System.Globalization.CultureInfo.InvariantCulture))%;"></div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <MudText Typo="Typo.body2" Style="color: var(--ink-subtle);">
                @L["No minutes on the pitch yet."]
            </MudText>
        }
    </MudPaper>

    <MudPaper Class="pa-5" Elevation="2" Style="border-radius: 16px;">
        <div class="card-label">@L["Per game"] (@_stats.Games.Count)</div>
        @* The minutes column is admin-only, and dropping a cell from a grid means dropping its
           track too — hence the class rather than an empty span. *@
        <div class="game-list @(_isAdmin ? "" : "game-list-no-minutes")">
            <div class="game-row game-head">
                <span class="g-opp">@L["Opponent"]</span>
                @if (_isAdmin)
                {
                    <span class="g-num">@L["Min"]</span>
                }
                <span class="g-num">@L["G"]</span>
                <span class="g-num">@L["Ast"]</span>
            </div>
            @foreach (var g in _stats.Games)
            {
                <div class="game-row">
                    <span class="g-opp">
                        <span class="g-opp-name">
                            <span class="g-opp-text">@g.Game.Opponent</span>
                            <VenueBadge IsHome="g.Game.IsHomeGame" Inline="true" />
                        </span>
                        <span class="g-date">@g.Game.Date.ToString("dd MMM yyyy")</span>
                    </span>
                    @if (_isAdmin)
                    {
                        <span class="g-num @(g.IsActual ? "" : "g-est")"
                              title="@(g.IsActual ? null : L["Estimated from the planned line-up — this match was not tracked live."].Value)">
                            @(g.Played ? (g.IsActual ? $"{g.Minutes}'" : $"~{g.Minutes}'") : "—")
                        </span>
                    }
                    <span class="g-num @(g.Goals > 0 ? "g-hit" : "")">@g.Goals</span>
                    <span class="g-num @(g.Assists > 0 ? "g-hit" : "")">@g.Assists</span>
                </div>
            }
        </div>
        @* The note explains the ~ on an estimated minute count, so it goes wherever those go. *@
        @if (_isAdmin && _stats.Games.Any(g => !g.IsActual))
        {
            <div class="game-note">
                @L["~ estimated from the planned line-up; matches tracked live use the real clock and substitutions."]
            </div>
        }
    </MudPaper>
</div>
