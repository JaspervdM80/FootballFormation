@inject IStringLocalizer<Strings> L

<MudDialog>
    <DialogContent>
        <div class="sub-off-line">
            <MudIcon Icon="@Icons.Material.Filled.PersonPin" Size="Size.Small" Color="Color.Primary" />
            <span class="sub-off-name">
                <PlayerLabel Player="PlayerOff" />
            </span>
            <span class="sub-off-pos">@L["came off"]</span>
        </div>

        <MudSelect T="int?" @bind-Value="SelectedOnId" Label="@L["Comes on"]" Class="mt-4">
            @foreach (var player in Candidates)
            {
                <MudSelectItem T="int?" Value="player.Id">
                    <PlayerLabel Player="player" />
                </MudSelectItem>
            }
        </MudSelect>

        <MudNumericField T="int" @bind-Value="SelectedMinute" Label="@L["Minute"]" Min="1" Max="MaxMinute"
                         Immediate="true" Class="mt-4" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(!HasChoice)" OnClick="Submit">
            @L["Save"]
        </MudButton>
    </DialogActions>
</MudDialog>
