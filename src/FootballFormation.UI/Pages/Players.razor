@page "/players"
@inject IStringLocalizer<Strings> L

<PageTitle>@L["Players"]</PageTitle>

@* The same split as /games: a circuit for the admin who manages the squad, plain HTML for everyone reading it. *@
<AuthorizeView Roles="@AppRoles.Admin">
    <Authorized>
        <SquadBoard @rendermode="InteractiveServer" />
    </Authorized>
    <NotAuthorized>
        <SquadBoard />
    </NotAuthorized>
</AuthorizeView>
