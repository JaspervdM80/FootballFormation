@inject IStringLocalizer<Strings> L

<MudDialog>
    <DialogContent>
        @if (IsOpponentGoal)
        {
            @* Their scorers are not tracked, so the minute is the whole of this dialog — the name is there to say whose goal it is. *@
            <MudText Typo="Typo.body2" Class="mb-1" Style="color: var(--ink-muted);">
                @L["Goal for {0}", Opponent]
            </MudText>
        }
        else
        {
            <MudSelect T="int?" @bind-Value="SelectedScorerId" Label="@L["Scorer"]" Class="mb-3">
                @foreach (var player in Candidates)
                {
                    <MudSelectItem T="int?" Value="player.Id">
                        <PlayerLabel Player="player" />
                    </MudSelectItem>
                }
            </MudSelect>

            <MudSelect T="int?" @bind-Value="SelectedAssisterId" Label="@L["Assist"]" Class="mb-3"
                       Placeholder="@L["No assist"]" Clearable="true">
                @foreach (var player in Candidates.Where(p => p.Id != SelectedScorerId))
                {
                    <MudSelectItem T="int?" Value="player.Id">
                        <PlayerLabel Player="player" />
                    </MudSelectItem>
                }
            </MudSelect>

            <MudSwitch @bind-Value="SelectedIsOwnGoal" Color="Color.Error" Class="mb-1">@L["Own goal"]</MudSwitch>
        }

        <MudNumericField T="int" @bind-Value="SelectedMinute" Label="@L["Minute"]" Min="1" Max="Ceiling"
                         Immediate="true" Class="mt-3" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(!HasChoice)" OnClick="Submit">
            @L["Save"]
        </MudButton>
    </DialogActions>
</MudDialog>
