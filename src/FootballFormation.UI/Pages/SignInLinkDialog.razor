@using FootballFormation.UI.Mail
@inject IStringLocalizer<Strings> L
@inject IPasswordLinkMailer Mailer

<MudDialog Class="dialog-touchline sign-in-link-dialog">
    <DialogContent>
        <div class="sign-in-link-body">
            <p class="sign-in-link-intro">
                @L["Send this link to {0}. It works once, for {1} days, and lets them choose their own password.", Link.DisplayName, (int)PasswordLinkService.CopiedLinkLifetime.TotalDays]
            </p>
            <div id="sign-in-link" class="sign-in-link">@Url</div>
            @* A plain onclick into js/clipboard.js: the clipboard refuses a copy once the click has gone through the circuit. *@
            <button type="button" class="overview-btn btn-gold sign-in-link-copy"
                    onclick="copyElementText('sign-in-link', 'sign-in-link-copied', 'sign-in-link-failed')">
                <MudIcon Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" />
                @L["Copy link"]
            </button>
            <div id="sign-in-link-copied" class="inline-notice inline-notice-success" role="status" hidden>
                @L["Copied to clipboard"]
            </div>
            <div id="sign-in-link-failed" class="inline-notice inline-notice-warning" role="alert" hidden>
                @L["Couldn't copy — try again"]
            </div>
            @if (Mailer.CanSend && Link.Email is null)
            {
                <p class="sign-in-link-note">@L["Give this account an email address to send the link by mail."]</p>
            }
            else if (Mailer.CanSend)
            {
                <button type="button" class="overview-btn btn-ghost sign-in-link-mail" disabled="@_mailed" @onclick="Mail">
                    <MudIcon Icon="@Icons.Material.Filled.Email" Size="Size.Small" />
                    <span>@L["Email the link to {0}", Link.Email!]</span>
                </button>
                @if (_mailed)
                {
                    <div class="inline-notice inline-notice-success" role="status">@L["The link is on its way to {0}", Link.Email!]</div>
                }
            }
            <p class="sign-in-link-note">
                @L["A new link replaces this one, and setting a password another way retires it."]
            </p>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="Close">@L["Close"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter, EditorRequired] public IssuedPasswordLink Link { get; set; } = null!;

    [Parameter, EditorRequired] public string Url { get; set; } = string.Empty;

    private bool _mailed;

    /// A second click can be on its way before the disabled button is drawn, and it would mail the coach twice.
    private void Mail() => _mailed = _mailed || Mailer.Send(Link);

    private void Close() => MudDialog.Cancel();
}
