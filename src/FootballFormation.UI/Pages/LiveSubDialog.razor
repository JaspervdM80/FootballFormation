@inject IStringLocalizer<Strings> L

<MudDialog Class="dialog-touchline">
    <DialogContent>
        <div class="sub-off-line">
            <MudIcon Icon="@Icons.Material.Filled.PersonPin" Size="Size.Small" Color="Color.Primary" />
            <span class="sub-off-name">
                <PlayerLabel Player="Player" />
            </span>
            <span class="sub-off-pos">@Position.ToString()</span>
        </div>

        @if (AllowSwapAndInjury)
        {
            @* Above the bench, because tapping who comes on is what makes the change. *@
            <MudSwitch @bind-Value="Injured" Color="Color.Error" Class="mt-3">@L["Injured"]</MudSwitch>
            <MudText Typo="Typo.caption" Style="color: var(--ink-muted); display: block;">
                @L["The rest of the match stops counting towards her playing time."]
            </MudText>
        }

        <MudText Typo="Typo.subtitle2" Class="mt-4 mb-2">@L["Comes on"]</MudText>
        @if (Bench.Count == 0)
        {
            <MudText Typo="Typo.body2" Style="color: var(--ink-muted);">@L["Nobody is on the bench for this half."]</MudText>
        }
        else
        {
            @* Disabled rather than overriding: a tap here would otherwise drop the swap already chosen below. *@
            <PlayerPicker Players="Bench" Label="@L["Comes on"]" OnPick="BringOn" Disabled="IsPositionSwap" />
        }

        @if (AllowSwapAndInjury)
        {
            <MudDivider Class="my-3" />
            <MudSelect T="int?" @bind-Value="SwapWithId" Label="@L["Swaps position with"]" Clearable="true"
                       Placeholder="@(OnPitch.Count == 0 ? L["Nobody else is on the pitch."].Value : null)"
                       Disabled="@(OnPitch.Count == 0 || Injured)">
                @foreach (var other in OnPitch)
                {
                    <MudSelectItem T="int?" Value="other.Player.Id">
                        <PlayerLabel Player="other.Player" /> — @other.Position.ToString()
                    </MudSelectItem>
                }
            </MudSelect>

            <MudText Typo="Typo.caption" Class="mt-2" Style="color: var(--ink-muted); display: block;">
                @L["A position swap keeps both players on the pitch and is not a substitution."]
            </MudText>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["Cancel"]</MudButton>
        @if (IsPositionSwap || Injured)
        {
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">
                @(IsPositionSwap ? L["Swap positions"] : L["Off injured"])
            </MudButton>
        }
    </DialogActions>
</MudDialog>
