@inject IStringLocalizer<Strings> L

<MudDialog>
    <DialogContent>
        <div class="sub-off-line">
            <MudIcon Icon="@Icons.Material.Filled.PersonPin" Size="Size.Small" Color="Color.Primary" />
            <span class="sub-off-name">
                <PlayerLabel Player="Player" />
            </span>
            <span class="sub-off-pos">@Position.ToString()</span>
        </div>

        @* Two lists, never both: picking in one clears the other, so the button below always has
           exactly one change to make. *@
        @* The placeholder only ever explains an empty list. MudSelect shows it whenever nothing is
           chosen, so a standing "nobody is on the bench" would greet a full bench too. *@
        <MudSelect T="int?" @bind-Value="PlayerOnId" Label="@L["Comes on"]" Class="mt-4" Clearable="true"
                   Placeholder="@(Bench.Count == 0 ? L["Nobody is on the bench for this half."].Value : null)"
                   Disabled="@(Bench.Count == 0)">
            @foreach (var player in Bench)
            {
                <MudSelectItem T="int?" Value="player.Id">
                    <PlayerLabel Player="player" />
                </MudSelectItem>
            }
        </MudSelect>

        <MudSelect T="int?" @bind-Value="SwapWithId" Label="@L["Swaps position with"]" Class="mt-4" Clearable="true"
                   Placeholder="@(OnPitch.Count == 0 ? L["Nobody else is on the pitch."].Value : null)"
                   Disabled="@(OnPitch.Count == 0 || Injured)">
            @foreach (var other in OnPitch)
            {
                <MudSelectItem T="int?" Value="other.Player.Id">
                    <PlayerLabel Player="other.Player" /> — @other.Position.ToString()
                </MudSelectItem>
            }
        </MudSelect>

        <MudText Typo="Typo.caption" Class="mt-2" Style="color: var(--ink-muted); display: block;">
            @L["A position swap keeps both players on the pitch and is not a substitution."]
        </MudText>

        @* Not a third list: it says why she is going off, so "Comes on" above still names her
           replacement — and with the bench empty, nobody, which is the one way this dialog closes
           without a name in it. *@
        <MudDivider Class="my-3" />
        <MudSwitch @bind-Value="Injured" Color="Color.Error">@L["Injured"]</MudSwitch>
        <MudText Typo="Typo.caption" Style="color: var(--ink-muted); display: block;">
            @L["The rest of the match stops counting towards her playing time."]
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(!HasChoice)" OnClick="Submit">
            @(IsPositionSwap ? L["Swap positions"] : Injured ? L["Off injured"] : L["Make substitution"])
        </MudButton>
    </DialogActions>
</MudDialog>
