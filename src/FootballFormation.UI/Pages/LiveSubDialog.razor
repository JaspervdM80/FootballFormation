@inject IStringLocalizer<Strings> L

<MudDialog>
    <DialogContent>
        <div class="sub-off-line">
            <MudIcon Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small" Color="Color.Error" />
            <span class="sub-off-name">
                @(PlayerOff.ShirtNumber is not null ? $"#{PlayerOff.ShirtNumber} " : "")@PlayerOff.DisplayName
            </span>
        </div>

        @if (Bench.Count == 0)
        {
            <MudText Typo="Typo.body2" Style="color: color-mix(in srgb, var(--ink) 45%, transparent);">
                @L["Nobody is on the bench for this period."]
            </MudText>
        }
        else
        {
            <MudForm @ref="Form">
                <MudSelect T="int" @bind-Value="PlayerOnId" Label="@L["Comes on"]" Class="mt-3"
                           Required="true" RequiredError="@L["Please select a player"]">
                    @foreach (var player in Bench)
                    {
                        <MudSelectItem T="int" Value="player.Id">
                            @(player.ShirtNumber is not null ? $"#{player.ShirtNumber} " : "")@player.DisplayName
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudForm>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(Bench.Count == 0)"
                   OnClick="Submit">
            @L["Make substitution"]
        </MudButton>
    </DialogActions>
</MudDialog>
