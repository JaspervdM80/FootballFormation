@inject IStringLocalizer<Strings> L

<MudDialog>
    <DialogContent>
        <MudForm @ref="Form">
            <MudSelect T="int" @bind-Value="PlayerId" Label="@L["Players"]" Class="mb-3"
                       Required="true" RequiredError="@L["Please select a player"]">
                @foreach (var player in Candidates)
                {
                    <MudSelectItem T="int" Value="player.Id">
                        <PlayerLabel Player="player" />
                    </MudSelectItem>
                }
            </MudSelect>
            <MudSwitch @bind-Value="IsGuest" Color="Color.Warning" Class="mb-1">@L["Guest player"]</MudSwitch>
            <MudText Typo="Typo.caption" Style="color: var(--ink-muted);">
                @L["Guests are left out of every game unless you add them to it explicitly."]
            </MudText>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">@L["Add to squad"]</MudButton>
    </DialogActions>
</MudDialog>
