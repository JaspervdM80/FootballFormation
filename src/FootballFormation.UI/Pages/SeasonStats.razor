@page "/stats"
@inherits SeasonAwarePage

<PageTitle>@L["Season statistics"]</PageTitle>

@if (!_loaded)
{
    <MudProgressCircular Indeterminate="true" />
    return;
}

@if (_stats is null)
{
    return;
}

<InlineNotice Notice="_notice" />

<PageHeader TitleTypo="Typo.h5" Title="@L["Season statistics"]"
            Subtitle="@(SeasonState.SelectedSeason is { } season
                ? L["Team and squad totals for {0}", season.Name]
                : L["Team and squad totals across all seasons"])" />

@* Admin-only, same as the report itself: who has played where is a selection tool, not a
   public figure. Below the header rather than in its Actions slot, which cramped the title row. *@
<AuthorizeView Roles="@AppRoles.Admin" Context="authActions">
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.GridView"
               Href="@AppRoutes.PositionDevelopment" Class="mb-4">
        @L["Position Development"]
    </MudButton>
</AuthorizeView>

<div class="stat-tiles mb-4">
    <div class="stat-tile">
        <div class="stat-value">@_stats.Played</div>
        <div class="stat-label">@L["Played"]</div>
    </div>
    <div class="stat-tile">
        <div class="stat-value">@($"{_stats.Won}-{_stats.Drawn}-{_stats.Lost}")</div>
        <div class="stat-label">@L["W-D-L"]</div>
        <div class="stat-sub">@L["{0}% won", _stats.WinPercentage.ToString("0")]</div>
    </div>
    <div class="stat-tile">
        <div class="stat-value">@_stats.GoalsFor</div>
        <div class="stat-label">@L["Goals for"]</div>
    </div>
    <div class="stat-tile">
        <div class="stat-value">@_stats.GoalsAgainst</div>
        <div class="stat-label">@L["Goals against"]</div>
        <div class="stat-sub">@(_stats.GoalDifference >= 0 ? "+" : "")@_stats.GoalDifference @L["diff"]</div>
    </div>
</div>

@if (_stats.Form.Count > 0)
{
    <div class="form-row mb-4">
        <span class="form-label">@L["Form"]</span>
        @foreach (var r in _stats.Form)
        {
            <span class="form-pill @r.ToString().ToLowerInvariant()" title="@L[r.ToString()]">@ResultLetter(r)</span>
        }
    </div>
}

<div class="stats-layout">
    <MudPaper Class="pa-5" Elevation="2" Style="border-radius: 16px;">
        <div class="card-label">@L["Top scorers"]</div>
        @if (_scorers.Count > 0)
        {
            <div class="rank-list">
                <div class="rank-row rank-head">
                    <span class="r-name">@L["Player"]</span>
                    <span class="g-num">@L["G"]</span>
                    <span class="g-num">@L["Ast"]</span>
                </div>
                @foreach (var p in _scorers)
                {
                    <a class="rank-row" href="@AppRoutes.PlayerStats(p.Player.Id)">
                        <span class="r-name">
                            @if (p.Player.ShirtNumber is not null)
                            {
                                <span class="r-shirt">@p.Player.ShirtNumber</span>
                            }
                            @p.Player.DisplayName
                        </span>
                        <span class="g-num g-hit">@p.Goals</span>
                        <span class="g-num @(p.Assists > 0 ? "g-hit" : "")">@p.Assists</span>
                    </a>
                }
            </div>
        }
        else
        {
            <MudText Typo="Typo.body2" Class="mt-2 empty-note">@L["No goals recorded yet."]</MudText>
        }
    </MudPaper>

    @* Minute figures are admin-only everywhere else on this page, and this card is the deliberate
       exception: who has kept goal, and for how long, is what the squad asks about. *@
    <MudPaper Class="pa-5" Elevation="2" Style="border-radius: 16px;">
        <div class="card-label">@L["Goalkeeper minutes"]</div>
        @if (_keepers.Count > 0)
        {
            <div class="rank-list">
                @foreach (var p in _keepers)
                {
                    <a class="rank-row rank-row-2col" href="@AppRoutes.PlayerStats(p.Player.Id)">
                        <span class="r-name">
                            @if (p.Player.ShirtNumber is not null)
                            {
                                <span class="r-shirt">@p.Player.ShirtNumber</span>
                            }
                            @p.Player.DisplayName
                        </span>
                        <span class="g-num g-hit">@p.GoalkeeperMinutes'</span>
                    </a>
                }
            </div>
        }
        else
        {
            <MudText Typo="Typo.body2" Class="mt-2 empty-note">@L["No goalkeeper minutes yet."]</MudText>
        }
    </MudPaper>
</div>

@* The card is minutes from top to bottom, so it is admin-only in full rather than redacted. *@
<AuthorizeView Roles="@AppRoles.Admin">
    <MudPaper Class="pa-5 mt-4" Elevation="2" Style="border-radius: 16px;">
        @* A checkbox rather than a bound component, the way the nav drawer is one: /stats has no
           circuit, so the two views are both rendered and CSS picks between them off :checked. *@
        <input type="checkbox" id="availability-toggle" class="availability-toggle" />
        <div class="live-card-head">
            <div class="card-label">@L["Playing time"]</div>
            @* One season only. Across all of them the maximum is the club's whole history, so a
               girl who joined this year reads as unavailable for the years before she was here. *@
            @if (SeasonId is not null)
            {
                <label class="availability-switch" for="availability-toggle">
                    <span class="availability-switch-track"></span>
                    @L["Availability"]
                </label>
            }
        </div>

        @if (_playingTime.Count > 0)
        {
            <div class="pt-legend">
                @foreach (var (cls, label) in Legend)
                {
                    <span class="pt-legend-item"><span class="pt-swatch @cls"></span>@label</span>
                }
            </div>

            <div class="pt-list">
                @foreach (var p in _playingTime)
                {
                    <a class="pt-row" href="@AppRoutes.PlayerStats(p.Player.Id)">
                        <div class="pt-head">
                            <span class="pt-name">
                                @if (p.Player.ShirtNumber is not null)
                                {
                                    <span class="r-shirt">@p.Player.ShirtNumber</span>
                                }
                                @p.Player.DisplayName
                            </span>
                            <span class="pt-meta pt-meta-share">@p.TotalMinutes' / @p.AvailableMinutes' · @(p.Utilization.ToString("0"))%</span>
                            <span class="pt-meta pt-meta-max">@p.TotalMinutes' / @p.MaximumMinutes' · @(p.Availability.ToString("0"))%</span>
                        </div>
                        @* Filled to the player's own available minutes, not to the busiest player's
                           total: this table is about how much of their time each of them got, and
                           against a squad maximum the top player is 100% by definition. *@
                        <div class="position-track">
                            <div class="position-fill" style="width: @(p.Utilization.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%;"></div>
                        </div>
                        @* The other view: the same maximum for everyone, so these bars compare
                           across rows. flex-grow rather than percentages — the four numbers
                           normalise themselves, whatever rounding did to them. *@
                        <div class="position-track pt-split">
                            <span class="pt-seg pt-played" style="flex-grow: @p.TotalMinutes;" title="@Figure(L["Played"], p.TotalMinutes)"></span>
                            <span class="pt-seg pt-injured" style="flex-grow: @p.InjuredMinutes;" title="@Figure(L["Injured"], p.InjuredMinutes)"></span>
                            <span class="pt-seg pt-unavailable" style="flex-grow: @p.UnavailableMinutes;" title="@Figure(L["Unavailable"], p.UnavailableMinutes)"></span>
                            <span class="pt-seg pt-idle" style="flex-grow: @p.NotPlayedMinutes;" title="@Figure(L["Not played"], p.NotPlayedMinutes)"></span>
                        </div>
                    </a>
                }
            </div>
        }
        else
        {
            <MudText Typo="Typo.body2" Class="mt-2 empty-note">@L["No players yet."]</MudText>
        }
    </MudPaper>
</AuthorizeView>
