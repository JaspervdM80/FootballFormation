@inject IStringLocalizer<Strings> L

<MudDialog Class="dialog-touchline">
    <DialogContent>
        @if (Scorer is null)
        {
            <MudSwitch @bind-Value="IsOwnGoal" Color="Color.Error" Class="mb-1">@L["Own goal"]</MudSwitch>
            <MudText Typo="Typo.caption" Class="mb-3" Style="color: var(--ink-muted); display: block;">
                @L["An own goal counts for the opponent."]
            </MudText>

            <MudText Typo="Typo.subtitle2" Class="mb-2">@L["Who scored?"]</MudText>
            <PlayerPicker Players="Candidates" Label="@L["Who scored?"]" OnPick="PickScorer" />
        }
        else
        {
            <MudText Typo="Typo.subtitle2" Class="mb-2">@L["Who gave the assist for {0}'s goal?", Scorer.ShortName]</MudText>
            <PlayerPicker Players="Assisters" Label="@L["Assist"]" OnPick="PickAssister" />
        }
    </DialogContent>
    <DialogActions>
        @if (Scorer is null)
        {
            <MudButton OnClick="Cancel">@L["Cancel"]</MudButton>
        }
        else
        {
            <MudButton OnClick="Back">@L["Back"]</MudButton>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="NoAssist">@L["No assist"]</MudButton>
        }
    </DialogActions>
</MudDialog>
