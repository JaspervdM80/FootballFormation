@page "/"
@inherits SeasonAwarePage
@using FootballFormation.Core.Reporting
@rendermode InteractiveServer

@* See InteractiveShell: the providers and the session gate this page no longer inherits, because
   the layout renders statically. *@
<InteractiveShell />

<PageTitle>@Team.DisplayName</PageTitle>

@* One banner for the whole of match day: waiting for kick-off, being played, and done. *@
@if (TodaysGame is not null)
{
    <a class="home-live-banner @BannerCssClass" href="@TodaysMatchUrl">
        @if (IsLive)
        {
            <span class="home-live-dot"></span>
        }
        else
        {
            <MudIcon Icon="@Icons.Material.Filled.SportsSoccer" Class="home-live-icon" />
        }
        <div class="home-live-body">
            <div class="home-live-label">@BannerLabel</div>
            <div class="home-live-match">
                @TodaysGame.Opponent<VenueBadge IsHome="TodaysGame.IsHomeGame" Inline="true" />
            </div>
        </div>
        @* Score reads in venue order, matching the live screen. Before kick-off there is no
           scoreline to report, so the chevron carries the row on its own. *@
        @if (TodaysGame.MatchState != MatchState.NotStarted)
        {
            <div class="home-live-score">@LiveScore</div>
        }
        <MudIcon Icon="@Icons.Material.Filled.ChevronRight" />
    </a>
}

<MatchNotifications />

<PageHeader Class="home-header" Title="@Team.DisplayName" />

<div class="home-dashboard mb-6">
    <section class="home-block">
        <div class="card-label">@L["Next match"]</div>
        @if (_dashboard.NextGame is { } next)
        {
            <a class="home-card home-fixture" href="@AppRoutes.Overview(next.Id)">
                <DateBlock Date="next.Date" />
                <div class="home-fixture-body">
                    <div class="home-card-title">
                        <span class="home-card-opponent">@next.Opponent</span><VenueBadge IsHome="next.IsHomeGame" Inline="true" />
                    </div>
                    @if (FixtureLine(next) is { } line)
                    {
                        <div class="home-card-line">@line</div>
                    }
                    @if (MatchCalendarReport.LocationOf(next) is { } ground)
                    {
                        <div class="home-card-line home-card-icon-line">
                            <MudIcon Icon="@Icons.Material.Filled.Place" Size="Size.Small" />@ground
                        </div>
                    }
                </div>
            </a>
        }
        else
        {
            <div class="home-card home-card-empty">@NoNextGameText</div>
        }
    </section>

    <section class="home-block">
        <div class="card-label">@RecordLabel</div>
        @if (_dashboard.Record.Played > 0)
        {
            <a class="home-card home-season" href="@AppRoutes.SeasonStats">
                <div class="home-wdl">
                    <div class="win"><b>@_dashboard.Record.Won</b><small>@L["Win"]</small></div>
                    <div class="draw"><b>@_dashboard.Record.Drawn</b><small>@L["Draw"]</small></div>
                    <div class="loss"><b>@_dashboard.Record.Lost</b><small>@L["Loss"]</small></div>
                </div>
                <FormGuide Form="_dashboard.Record.Form" />
                <div class="home-card-line">@L["Goal difference: {0}", GoalDifference]</div>
            </a>
        }
        else
        {
            <div class="home-card home-card-empty">@L["No matches played yet."]</div>
        }
    </section>

    <section class="home-block">
        <div class="card-label">@L["Last result"]</div>
        @if (_dashboard.LastGame is { } last)
        {
            <a class="home-card" href="@AppRoutes.Result(last.Id)">
                <div class="home-card-result">
                    <span class="home-card-opponent">@last.Opponent</span><VenueBadge IsHome="last.IsHomeGame" Inline="true" />
                    <span class="home-card-score">@last.ScoreboardOrder()</span>
                    <ResultPill Result="SeasonStatsReport.ResultOf(last)" />
                </div>
                <div class="home-card-line">@CardDate(last)</div>
                @if (_dashboard.LastScorers.Count > 0)
                {
                    <div class="home-card-line home-card-icon-line">
                        <MudIcon Icon="@Icons.Material.Filled.SportsSoccer" Size="Size.Small" />@Scorers
                    </div>
                }
            </a>
        }
        else
        {
            <div class="home-card home-card-empty">@L["No matches played yet."]</div>
        }
    </section>
</div>

@* Shortcuts, not status: flat and tinted so they never read as another card in the dashboard above. Whole tiles are the target —
   a single destination needs no button repeating it, and the larger hit area is what a thumb wants. *@
<div class="home-tiles">
    <a class="home-tile-link" href="@AppRoutes.Games">
        <span class="home-tile-icon"><MudIcon Icon="@Icons.Material.Filled.SportsSoccer" /></span>
        <span class="home-tile-text">
            <span class="home-tile-title">@L["Games & Formations"]</span>
            <span class="home-tile-body">
            <AuthorizeView Roles="@AppRoles.Admin">
                <Authorized>@L["Create games, build formations, and track results."]</Authorized>
                <NotAuthorized>@L["Fixtures, line-ups and results."]</NotAuthorized>
            </AuthorizeView>
        </span>
        </span>
        <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Class="home-tile-chevron" />
    </a>
    <a class="home-tile-link" href="@AppRoutes.SeasonStats">
        <span class="home-tile-icon"><MudIcon Icon="@Icons.Material.Filled.BarChart" /></span>
        <span class="home-tile-text">
            <span class="home-tile-title">@L["Season stats"]</span>
            <span class="home-tile-body">
            <AuthorizeView Roles="@AppRoles.Admin">
                <Authorized>@L["See the team record, top scorers, and playing time."]</Authorized>
                <NotAuthorized>@L["The team record, top scorers and goalkeepers."]</NotAuthorized>
            </AuthorizeView>
        </span>
        </span>
        <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Class="home-tile-chevron" />
    </a>

    @* /trainings and /preferences are [Authorize]d, so a visitor tapping either tile only ever reached the
       login screen. Hide the whole tile rather than offer a door that is locked. *@
    <AuthorizeView Roles="@AppRoles.Admin">
        <a class="home-tile-link" href="@AppRoutes.Trainings">
            <span class="home-tile-icon"><MudIcon Icon="@Icons.Material.Filled.FitnessCenter" /></span>
            <span class="home-tile-text">
                <span class="home-tile-title">@L["Trainings"]</span>
                <span class="home-tile-body">@L["Keep the training evenings, and note who was not there."]</span>
            </span>
            <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Class="home-tile-chevron" />
        </a>
        <a class="home-tile-link" href="@AppRoutes.Preferences">
            <span class="home-tile-icon"><MudIcon Icon="@Icons.Material.Filled.Tune" /></span>
            <span class="home-tile-text">
                <span class="home-tile-title">@L["Preferences"]</span>
                <span class="home-tile-body">@L["Configure match duration, split type, and defaults."]</span>
            </span>
            <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Class="home-tile-chevron" />
        </a>
    </AuthorizeView>

    <a class="home-tile-link" href="@AppRoutes.Duties">
        <span class="home-tile-icon"><MudIcon Icon="@Icons.Material.Filled.AssignmentInd" /></span>
        <span class="home-tile-text">
            <span class="home-tile-title">@L["Duties"]</span>
            <span class="home-tile-body">@DutiesText</span>
        </span>
        <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Class="home-tile-chevron" />
    </a>
</div>
