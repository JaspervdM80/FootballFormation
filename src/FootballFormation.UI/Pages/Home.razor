@page "/"
@inherits CancellableComponent
@rendermode InteractiveServer

@* See InteractiveShell: the providers and the session gate this page no longer inherits, because
   the layout renders statically. *@
<InteractiveShell />

<PageTitle>GJS Meiden</PageTitle>

@* One banner for the whole of match day: waiting for kick-off, being played, and done. *@
@if (TodaysGame is not null)
{
    <a class="home-live-banner @BannerCssClass" href="@TodaysMatchUrl">
        @if (IsLive)
        {
            <span class="home-live-dot"></span>
        }
        else
        {
            <MudIcon Icon="@Icons.Material.Filled.SportsSoccer" Class="home-live-icon" />
        }
        <div class="home-live-body">
            <div class="home-live-label">@BannerLabel</div>
            <div class="home-live-match">
                @TodaysGame.Opponent<VenueBadge IsHome="TodaysGame.IsHomeGame" Inline="true" />
            </div>
        </div>
        @* Score reads in venue order, matching the live screen. Before kick-off there is no
           scoreline to report, so the chevron carries the row on its own. *@
        @if (TodaysGame.MatchState != MatchState.NotStarted)
        {
            <div class="home-live-score">@LiveScore</div>
        }
        <MudIcon Icon="@Icons.Material.Filled.ChevronRight" />
    </a>
}

<PageHeader Class="mb-6" Title="GJS Meiden"
            Subtitle="@L["Plan your team's formations, manage your squad, and organize game lineups."]" />

@* Whole tiles are the target — a card with a single destination does not need a button
   repeating it, and the larger hit area is what a thumb wants on a phone. *@
<MudGrid Spacing="4">
    <MudItem xs="12" sm="6" md="4">
        <a class="home-tile-link" href="@AppRoutes.Players">
            <MudPaper Class="pa-5 home-tile" Elevation="2" Style="border-radius: 16px;">
                <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Large" Style="color: var(--club-primary-bright);" />
                <MudText Typo="Typo.h6" Class="mt-3" Style="color: var(--ink);">@L["Selection"]</MudText>
                <AuthorizeView Roles="@AppRoles.Admin">
                    <MudText Typo="Typo.body2" Style="color: var(--ink-muted);">
                        @L["Add players with their positions and shirt numbers."]
                    </MudText>
                </AuthorizeView>
            </MudPaper>
        </a>
    </MudItem>

    <MudItem xs="12" sm="6" md="4">
        <a class="home-tile-link" href="@AppRoutes.Games">
            <MudPaper Class="pa-5 home-tile" Elevation="2" Style="border-radius: 16px;">
                <MudIcon Icon="@Icons.Material.Filled.SportsSoccer" Size="Size.Large" Style="color: var(--club-primary-bright);" />
                <MudText Typo="Typo.h6" Class="mt-3" Style="color: var(--ink);">@L["Games & Formations"]</MudText>
                <AuthorizeView Roles="@AppRoles.Admin">
                    <MudText Typo="Typo.body2" Style="color: var(--ink-muted);">
                        @L["Create games, build formations, and track results."]
                    </MudText>
                </AuthorizeView>
            </MudPaper>
        </a>
    </MudItem>

    <MudItem xs="12" sm="6" md="4">
        <a class="home-tile-link" href="@AppRoutes.SeasonStats">
            <MudPaper Class="pa-5 home-tile" Elevation="2" Style="border-radius: 16px;">
                <MudIcon Icon="@Icons.Material.Filled.BarChart" Size="Size.Large" Style="color: var(--club-primary-bright);" />
                <MudText Typo="Typo.h6" Class="mt-3" Style="color: var(--ink);">@L["Season stats"]</MudText>
                <AuthorizeView Roles="@AppRoles.Admin">
                    <MudText Typo="Typo.body2" Style="color: var(--ink-muted);">
                        @L["See the team record, top scorers, and playing time."]
                    </MudText>
                </AuthorizeView>
            </MudPaper>
        </a>
    </MudItem>

    @* /settings is [Authorize], so a visitor tapping this tile only ever reached the login
       screen. Hide the whole tile rather than offer a door that is locked. *@
    <AuthorizeView Roles="@AppRoles.Admin">
        <MudItem xs="12" sm="6" md="4">
            <a class="home-tile-link" href="@AppRoutes.Settings">
                <MudPaper Class="pa-5 home-tile" Elevation="2" Style="border-radius: 16px;">
                    <MudIcon Icon="@Icons.Material.Filled.Settings" Size="Size.Large" Style="color: var(--club-primary-bright);" />
                    <MudText Typo="Typo.h6" Class="mt-3" Style="color: var(--ink);">@L["Preferences"]</MudText>
                    <MudText Typo="Typo.body2" Style="color: var(--ink-muted);">
                        @L["Configure match duration, split type, and defaults."]
                    </MudText>
                </MudPaper>
            </a>
        </MudItem>
    </AuthorizeView>
</MudGrid>
