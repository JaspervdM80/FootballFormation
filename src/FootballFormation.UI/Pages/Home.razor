@page "/"
@inherits SeasonAwarePage
@using FootballFormation.Core.Reporting
@rendermode InteractiveServer

@* See InteractiveShell: the providers and the session gate this page no longer inherits, because
   the layout renders statically. *@
<InteractiveShell />

<PageTitle>@Team.DisplayName</PageTitle>

@* One banner for the whole of match day: waiting for kick-off, being played, and done. *@
@if (TodaysGame is not null)
{
    <a class="home-live-banner @BannerCssClass" href="@TodaysMatchUrl">
        @if (IsLive)
        {
            <span class="home-live-dot"></span>
        }
        else
        {
            <MudIcon Icon="@Icons.Material.Filled.SportsSoccer" Class="home-live-icon" />
        }
        <div class="home-live-body">
            <div class="home-live-label">@BannerLabel</div>
            <div class="home-live-match">
                @TodaysGame.Opponent<VenueBadge IsHome="TodaysGame.IsHomeGame" Inline="true" />
            </div>
        </div>
        @* Score reads in venue order, matching the live screen. Before kick-off there is no
           scoreline to report, so the chevron carries the row on its own. *@
        @if (TodaysGame.MatchState != MatchState.NotStarted)
        {
            <div class="home-live-score">@LiveScore</div>
        }
        <MudIcon Icon="@Icons.Material.Filled.ChevronRight" />
    </a>
}

<MatchNotifications />

<PageHeader Class="mb-6" Title="@Team.DisplayName"
            Subtitle="@L["Plan your team's formations, manage your squad, and organize game lineups."]" />

<div class="home-dashboard mb-6">
    @if (_dashboard.NextGame is { } next)
    {
        <a class="home-card" href="@AppRoutes.Overview(next.Id)">
            <div class="home-card-label">@L["Next match"]</div>
            <div class="home-card-title">
                <span class="home-card-opponent">@next.Opponent</span><VenueBadge IsHome="next.IsHomeGame" Inline="true" />
            </div>
            <div class="home-card-line">@CardDate(next)</div>
            @if (MeetLine(next) is { } meet)
            {
                <div class="home-card-line">@meet</div>
            }
        </a>
    }
    else
    {
        <div class="home-card home-card-empty">
            <div class="home-card-label">@L["Next match"]</div>
            <div class="home-card-line">@NoNextGameText</div>
        </div>
    }

    @if (_dashboard.LastGame is { } last)
    {
        <a class="home-card" href="@AppRoutes.Result(last.Id)">
            <div class="home-card-label">@L["Last result"]</div>
            <div class="home-card-title">
                <span class="home-card-opponent">@last.Opponent</span><VenueBadge IsHome="last.IsHomeGame" Inline="true" />
            </div>
            <div class="home-card-result">
                <span class="home-card-score">@last.ScoreboardOrder()</span>
                <ResultPill Result="SeasonStatsReport.ResultOf(last)" />
            </div>
            <div class="home-card-line">@CardDate(last)</div>
            @if (_dashboard.LastScorers.Count > 0)
            {
                <div class="home-card-line home-card-scorers">
                    <MudIcon Icon="@Icons.Material.Filled.SportsSoccer" Size="Size.Small" />@Scorers
                </div>
            }
        </a>
    }
    else
    {
        <div class="home-card home-card-empty">
            <div class="home-card-label">@L["Last result"]</div>
            <div class="home-card-line">@L["No matches played yet."]</div>
        </div>
    }

    <a class="home-card" href="@AppRoutes.SeasonStats">
        <div class="home-card-label">@RecordLabel</div>
        @if (_dashboard.Record.Played > 0)
        {
            <div class="home-card-caption">@L["W-D-L"]</div>
            <div class="home-card-record">@($"{_dashboard.Record.Won}-{_dashboard.Record.Drawn}-{_dashboard.Record.Lost}")</div>
            <div class="home-card-line">@L["Goal difference: {0}", GoalDifference]</div>
            <FormGuide Form="_dashboard.Record.Form" />
        }
        else
        {
            <div class="home-card-line">@L["No matches played yet."]</div>
        }
    </a>
</div>

@* Whole tiles are the target — a card with a single destination does not need a button
   repeating it, and the larger hit area is what a thumb wants on a phone. *@
<MudGrid Spacing="4">
    <MudItem xs="12" sm="6" md="4">
        <a class="home-tile-link" href="@AppRoutes.Players">
            <MudPaper Class="pa-5 home-tile" Elevation="2" Style="border-radius: 16px;">
                <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Large" Style="color: var(--club-primary-bright);" />
                <MudText Typo="Typo.h6" Class="mt-3" Style="color: var(--ink);">@L["Selection"]</MudText>
                <MudText Typo="Typo.body2" Style="color: var(--ink-muted);">
                    <AuthorizeView Roles="@AppRoles.Admin">
                        <Authorized>@L["Add players with their positions and shirt numbers."]</Authorized>
                        <NotAuthorized>@L["The players in the squad, with their shirt numbers."]</NotAuthorized>
                    </AuthorizeView>
                </MudText>
            </MudPaper>
        </a>
    </MudItem>

    <MudItem xs="12" sm="6" md="4">
        <a class="home-tile-link" href="@AppRoutes.Games">
            <MudPaper Class="pa-5 home-tile" Elevation="2" Style="border-radius: 16px;">
                <MudIcon Icon="@Icons.Material.Filled.SportsSoccer" Size="Size.Large" Style="color: var(--club-primary-bright);" />
                <MudText Typo="Typo.h6" Class="mt-3" Style="color: var(--ink);">@L["Games & Formations"]</MudText>
                <MudText Typo="Typo.body2" Style="color: var(--ink-muted);">
                    <AuthorizeView Roles="@AppRoles.Admin">
                        <Authorized>@L["Create games, build formations, and track results."]</Authorized>
                        <NotAuthorized>@L["Fixtures, line-ups and results."]</NotAuthorized>
                    </AuthorizeView>
                </MudText>
            </MudPaper>
        </a>
    </MudItem>

    <MudItem xs="12" sm="6" md="4">
        <a class="home-tile-link" href="@AppRoutes.SeasonStats">
            <MudPaper Class="pa-5 home-tile" Elevation="2" Style="border-radius: 16px;">
                <MudIcon Icon="@Icons.Material.Filled.BarChart" Size="Size.Large" Style="color: var(--club-primary-bright);" />
                <MudText Typo="Typo.h6" Class="mt-3" Style="color: var(--ink);">@L["Season stats"]</MudText>
                <MudText Typo="Typo.body2" Style="color: var(--ink-muted);">
                    <AuthorizeView Roles="@AppRoles.Admin">
                        <Authorized>@L["See the team record, top scorers, and playing time."]</Authorized>
                        <NotAuthorized>@L["The team record, top scorers and goalkeepers."]</NotAuthorized>
                    </AuthorizeView>
                </MudText>
            </MudPaper>
        </a>
    </MudItem>

    @* /trainings and /preferences are [Authorize]d, so a visitor tapping either tile only ever reached the
       login screen. Hide the whole tile rather than offer a door that is locked. *@
    <AuthorizeView Roles="@AppRoles.Admin">
        <MudItem xs="12" sm="6" md="4">
            <a class="home-tile-link" href="@AppRoutes.Trainings">
                <MudPaper Class="pa-5 home-tile" Elevation="2" Style="border-radius: 16px;">
                    <MudIcon Icon="@Icons.Material.Filled.FitnessCenter" Size="Size.Large" Style="color: var(--club-primary-bright);" />
                    <MudText Typo="Typo.h6" Class="mt-3" Style="color: var(--ink);">@L["Trainings"]</MudText>
                    <MudText Typo="Typo.body2" Style="color: var(--ink-muted);">
                        @L["Keep the training evenings, and note who was not there."]
                    </MudText>
                </MudPaper>
            </a>
        </MudItem>

        <MudItem xs="12" sm="6" md="4">
            <a class="home-tile-link" href="@AppRoutes.Preferences">
                <MudPaper Class="pa-5 home-tile" Elevation="2" Style="border-radius: 16px;">
                    <MudIcon Icon="@Icons.Material.Filled.Tune" Size="Size.Large" Style="color: var(--club-primary-bright);" />
                    <MudText Typo="Typo.h6" Class="mt-3" Style="color: var(--ink);">@L["Preferences"]</MudText>
                    <MudText Typo="Typo.body2" Style="color: var(--ink-muted);">
                        @L["Configure match duration, split type, and defaults."]
                    </MudText>
                </MudPaper>
            </a>
        </MudItem>
    </AuthorizeView>

    <MudItem xs="12" sm="6" md="4">
        <a class="home-tile-link" href="@AppRoutes.Duties">
            <MudPaper Class="pa-5 home-tile" Elevation="2" Style="border-radius: 16px;">
                <MudIcon Icon="@Icons.Material.Filled.AssignmentInd" Size="Size.Large" Style="color: var(--club-primary-bright);" />
                <MudText Typo="Typo.h6" Class="mt-3" Style="color: var(--ink);">@L["Duties"]</MudText>
                <MudText Typo="Typo.body2" Style="color: var(--ink-muted);">
                    @DutiesText
                </MudText>
            </MudPaper>
        </a>
    </MudItem>
</MudGrid>
