@page "/trainings"
@attribute [Authorize(Roles = AppRoles.Admin)]
@inherits SeasonAwarePage
@rendermode InteractiveServer

@* See InteractiveShell: the providers and the session gate this page no longer inherits, because
   the layout renders statically. *@
<InteractiveShell RequiresRole="@AppRoles.Admin" />

<PageTitle>@L["Trainings"]</PageTitle>

<PageHeader Class="mb-6" Title="@L["Trainings"]">
    <SubtitleContent>
        <MudText Typo="Typo.body2" Class="page-header-subtitle">
            @if (_trainings is not null)
            {
                @(_trainings.Count == 1 ? L["{0} training", _trainings.Count] : L["{0} trainings", _trainings.Count])
                @if (SeasonState.SelectedSeason is { } season)
                {
                    <span> · @season.Name</span>
                }
                var cancelled = _trainings.Count(t => t.DidNotTakePlace);
                if (cancelled > 0)
                {
                    <span> · @L["{0} cancelled", cancelled]</span>
                }
            }
        </MudText>
    </SubtitleContent>
    <Actions>
        <MudButton Variant="Variant.Filled" Class="btn-gold btn-compact" StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OpenAddDialog">
            @L["Add"]
        </MudButton>
    </Actions>
</PageHeader>

@* Collapsed by default: the register is what the page is for, and a squad's worth of rows above it would push this week's session off
   the screen. A <details> rather than a bound panel, the same as the season picker — the browser brings the keyboard behaviour. *@
@* Sessions alone are not enough to report on: a season whose training period was saved before the squad was filled in has ninety
   evenings and nobody to measure against them, and the percentage over an empty squad reads as 0% rather than as "no answer yet". *@
@if (_attendance is { Held: > 0, Players.Count: > 0 })
{
    <details class="attendance mb-6">
        <summary>
            <span class="attendance-label">@L["Attendance"]</span>
            <span class="attendance-figure">@_attendance.Percentage.ToString("0")%</span>
            <span class="attendance-sub">@L["{0} sessions held", _attendance.Held]</span>
            <MudIcon Icon="@Icons.Material.Filled.ExpandMore" Size="Size.Small" />
        </summary>
        <div class="attendance-rows">
            @foreach (var row in _attendance.Players)
            {
                <a class="attendance-row" href="@AppRoutes.PlayerStats(row.Player.Id)">
                    <span class="a-name"><PlayerLabel Player="row.Player" /></span>
                    <span class="a-meta">@row.Attended / @row.Held · @(row.Percentage.ToString("0"))%</span>
                    <div class="position-track">
                        <div class="position-fill" style="width: @(row.Percentage.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%;"></div>
                    </div>
                </a>
            }
        </div>
    </details>
}

@if (_trainings is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_trainings.Count == 0)
{
    <MudPaper Class="pa-6" Elevation="2" Style="border-radius: 16px; text-align: center;">
        <MudIcon Icon="@Icons.Material.Filled.FitnessCenter" Size="Size.Large" Style="color: var(--ink-faint);" />
        <MudText Typo="Typo.body1" Class="mt-3" Style="color: var(--ink-muted);">
            @(SeasonState.SelectedSeason is { } season
                ? L["No trainings in {0} yet.", season.Name]
                : L["No trainings yet. Add your first session!"])
        </MudText>
        <MudText Typo="Typo.caption" Class="mt-2 d-block" Style="color: var(--ink-faint);">
            @L["Set the training days and the first and last training under Preferences, and the sessions fill themselves in."]
        </MudText>
    </MudPaper>
}
else
{
    @foreach (var week in Weeks())
    {
        @if (week.OpensThePast)
        {
            <div class="training-earlier">@L["Earlier"]</div>
        }
        <div class="training-week">
            <div class="card-label">@week.Title</div>
            <div class="training-rows">
                @foreach (var training in week.Trainings)
                {
                    @* An evening that did not happen is dimmed rather than hidden: the week reads honestly, and the sessions that were
                       actually held still read first. *@
                    <div class="training-row @(training.DidNotTakePlace ? "cancelled" : "")" @onclick="() => OpenEditDialog(training)">
                        <span class="training-date">@training.Date.ToString("ddd dd MMM")</span>
                        @if (training.DidNotTakePlace)
                        {
                            <span class="badge-warning">@L["Cancelled"]</span>
                        }
                        else if (training.UnavailablePlayerIds.Count > 0)
                        {
                            <span class="badge-unavailable" title="@UnavailableNames(training)">@L["{0} out", training.UnavailablePlayerIds.Count]</span>
                        }
                        else if (training.HasBeenHeld(Today))
                        {
                            @* Held, not merely absence-free: an empty register on an evening still to come means nobody has said
                               otherwise yet, not that the whole squad turned up. *@
                            <span class="badge-present">@L["{0} out", 0]</span>
                        }
                        <span class="training-notes">@training.Notes</span>
                        <div class="training-actions" @onclick:stopPropagation="true">
                            <button class="action-btn" title="@L["Edit"]" @onclick="() => OpenEditDialog(training)">
                                <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" />
                            </button>
                            <button class="action-btn action-delete" title="@L["Delete"]" @onclick="() => DeleteTraining(training)">
                                <MudIcon Icon="@Icons.Material.Filled.Delete" Size="Size.Small" />
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
}
