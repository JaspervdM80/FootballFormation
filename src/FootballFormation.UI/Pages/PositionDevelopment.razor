@page "/stats/positions"
@attribute [Authorize(Roles = AppRoles.Admin)]
@inherits SeasonAwarePage

<PageTitle>@L["Position Development"]</PageTitle>

@if (!_loaded)
{
    <MudProgressCircular Indeterminate="true" />
    return;
}

<InlineNotice Notice="_notice" />

@* The hint spells out what the row chevron only hints at, the way the squad table does. *@
<PageHeader BackFallback="@AppRoutes.SeasonStats" TitleTypo="Typo.h5" Title="@L["Position Development"]">
    <SubtitleContent>
        <MudText Typo="Typo.body2" Style="color: var(--ink-muted);">
            @(SeasonState.SelectedSeason is { } season
                ? L["Who has played where in {0}, at a glance.", season.Name]
                : L["Who has played where across all seasons, at a glance."])
        </MudText>
        @if (_report is { Rows.Count: > 0 })
        {
            <MudText Typo="Typo.caption" Class="squad-hint">
                <MudIcon Icon="@Icons.Material.Filled.TouchApp" Size="Size.Small" />
                @L["Tap a player's name to see their statistics."]
            </MudText>
        }
    </SubtitleContent>
</PageHeader>

@if (_report is null || _report.Rows.Count == 0)
{
    <MudPaper Class="pa-6" Elevation="2" Style="border-radius: 16px; text-align: center;">
        <MudIcon Icon="@Icons.Material.Filled.GridView" Size="Size.Large" Style="color: var(--ink-faint);" />
        <MudText Typo="Typo.body1" Class="mt-3" Style="color: var(--ink-muted);">
            @L["No minutes on the pitch yet."]
        </MudText>
    </MudPaper>
    return;
}

<div class="stat-tiles stat-tiles-3 mb-4">
    <div class="stat-tile">
        <div class="stat-value">@_report.PlayersUsed</div>
        <div class="stat-label">@L["Players used"]</div>
    </div>
    <div class="stat-tile">
        <div class="stat-value">@_report.PositionsUsed</div>
        <div class="stat-label">@L["Positions used"]</div>
    </div>
    <div class="stat-tile">
        <div class="stat-value">@_report.SinglePositionPlayers</div>
        <div class="stat-label">@L["Single position"]</div>
        <div class="stat-sub">@L["of {0} players", _report.PlayersUsed]</div>
    </div>
</div>

<MudTable Items="_report.Rows" Hover="true" Dense="true" Elevation="2" T="PositionDevelopmentRow"
          HorizontalScrollbar="true"
          Class="position-dev-table stacked-table" Style="border-radius: 16px;">
    <HeaderContent>
        <MudTh>#</MudTh>
        <MudTh>@L["Player"]</MudTh>
        @* Abbreviated, like the squad badges and the pitch chips — a column per position spelled
           out in full runs the grid off the side of a laptop. The full name is the tooltip. *@
        @foreach (var position in _report.Positions)
        {
            <MudTh Style="text-align:center" title="@L[position.DisplayName()]">@position.ToString()</MudTh>
        }
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="#" Class="pd-num">
            <span style="font-weight: 700; color: var(--club-primary-bright);">@(context.Player.ShirtNumber?.ToString() ?? "-")</span>
        </MudTd>
        <MudTd DataLabel="@L["Player"]" Class="pd-name">
            @* The name is the link, rather than a handler on the row: a row click cannot be an
               anchor, and this page renders without a circuit to dispatch one to. *@
            <a class="pd-name-cell" href="@AppRoutes.PlayerStats(context.Player.Id)">
                <span style="font-weight: 600; color: var(--ink);">@context.Player.DisplayName</span>
                @if (context.IsSinglePosition)
                {
                    <span class="badge-warning" title="@L["Every minute played came in one position."]">
                        @L["Single position"]
                    </span>
                }
                <span class="player-name-chevron" aria-hidden="true">›</span>
            </a>
        </MudTd>
        @foreach (var position in _report.Positions)
        {
            var stat = context.Positions.GetValueOrDefault(position);
            <MudTd DataLabel="@L[position.DisplayName()]" Class="@("pd-pos" + (stat is null ? " pd-pos-empty" : ""))">
                @if (stat is not null)
                {
                    <span class="pd-pos-value">
                        @* The phone card has no column headers to read the figure against — and
                           .stacked-table drops MudBlazor's own DataLabel — so the chip says which
                           position it is itself. Hidden on the desktop grid, where the header does. *@
                        <span class="pd-pos-label">@position.ToString()</span>
                        @stat.Minutes'
                        <span class="pd-pos-pct">@stat.Percentage.ToString("0")%</span>
                    </span>
                }
                else
                {
                    <span class="pd-pos-dash">–</span>
                }
            </MudTd>
        }
    </RowTemplate>
</MudTable>
