@inject IStringLocalizer<Strings> L

<MudDialog>
    <DialogContent>
        @if (Halves.Count > 1)
        {
            <MudSelect T="PeriodType" Value="SelectedHalf" ValueChanged="ChooseHalf" Label="@L["Which half"]" Class="mb-4">
                @foreach (var half in Halves)
                {
                    <MudSelectItem T="PeriodType" Value="half.Half">@L[half.Half.DisplayName()]</MudSelectItem>
                }
            </MudSelect>
        }

        <MudSelect T="int?" Value="SelectedAId" ValueChanged="ChooseA" Label="@L["Player"]">
            @foreach (var entry in Current.OnPitch)
            {
                <MudSelectItem T="int?" Value="entry.Player.Id">
                    <PlayerLabel Player="entry.Player" /> — @entry.Position.ToString()
                </MudSelectItem>
            }
        </MudSelect>

        <MudSelect T="int?" @bind-Value="SelectedBId" Label="@L["Swaps position with"]" Class="mt-4">
            @foreach (var entry in Current.OnPitch.Where(e => e.Player.Id != SelectedAId))
            {
                <MudSelectItem T="int?" Value="entry.Player.Id">
                    <PlayerLabel Player="entry.Player" /> — @entry.Position.ToString()
                </MudSelectItem>
            }
        </MudSelect>

        <MudText Typo="Typo.caption" Class="mt-3" Style="color: var(--ink-muted); display: block;">
            @L["Each of them is credited the new position for all of their time on in that half."]
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(!HasChoice)" OnClick="Submit">
            @L["Swap positions"]
        </MudButton>
    </DialogActions>
</MudDialog>
