@inject IStringLocalizer<Strings> L

@if (Visible && SeasonState.Seasons.Count > 0)
{
    @* MudMenu's own activator button rather than ActivatorContent: in MudBlazor 9 a custom
       activator has to wire context.ToggleAsync itself and leaves the wrapper focusable but
       inert, whereas the built-in button arrives keyboard-accessible and correctly labelled. *@
    <MudMenu Label="@Label"
             StartIcon="@Icons.Material.Filled.CalendarMonth"
             EndIcon="@Icons.Material.Filled.ExpandMore"
             Variant="Variant.Text"
             Size="Size.Small"
             Dense="true"
             AriaLabel="@L["Select season"]"
             Class="season-picker">
        @foreach (var season in SeasonState.Seasons)
        {
            <MudMenuItem OnClick="@(() => SeasonState.Select(season.Id))">
                <span class="season-menu-item">
                    <span>@season.Name</span>
                    @if (season.IsCurrent)
                    {
                        <span class="badge-teal">@L["Current"]</span>
                    }
                </span>
            </MudMenuItem>
        }
        <MudDivider />
        <MudMenuItem OnClick="@(() => SeasonState.Select(null))">@L["All seasons"]</MudMenuItem>
    </MudMenu>
}
