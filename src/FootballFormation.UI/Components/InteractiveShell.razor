@namespace FootballFormation.UI.Components

@* What an interactive page no longer inherits, because MainLayout renders statically and RouteView applies it outside the island. Every
   such page renders one of these first. *@

@* A render mode cannot go on a layout at all — @Body is a RenderFragment Blazor cannot serialise as a root parameter — so left there
   these three would be static, which looks like dialogs that simply never appear. See docs/known_issues/blazor-mudblazor.md. *@
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@* AuthorizeRouteView still guards the route, but it lives in the static router and is evaluated once per request — this is the same
   NotAuthorized branch inside the island, which goes on hearing the revalidating provider. *@
@if (RequiresRole is not null)
{
    <AuthorizeView Roles="@RequiresRole">
        <NotAuthorized>
            <RedirectToLogin />
        </NotAuthorized>
    </AuthorizeView>
}

@code {
    /// Mirrors the page's own <c>[Authorize(Roles = ...)]</c>: the attribute is read by the router, this inside the island, and only the
    /// island is still listening once the page is up. Null on a page open to everyone.
    [Parameter] public string? RequiresRole { get; set; }
}
