@* An anchor, not a MudIconButton with an OnClick: this renders on pages with no circuit to dispatch a click to, and back.js takes it
   from there. .back-button lives in app.css because scoped CSS cannot reach the element MudIcon renders. *@
<a href="@Fallback" class="back-button" aria-label="@Label" title="@Label" data-back-format="@L["Back to {0}"]">
    <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" />
</a>
