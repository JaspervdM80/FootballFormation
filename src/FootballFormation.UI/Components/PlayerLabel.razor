@*
    A player as one line of text: "#7 Jasper", or just the name when they have no shirt number.
    Used wherever a player is named in prose or a list — dialogs, the bench, the scorer pickers —
    so the format is decided once instead of at every call site.
*@
@if (Player is not null)
{
    @(Player.ShirtNumber is not null ? $"#{Player.ShirtNumber} " : "")@Player.DisplayName
}

@code {
    /// <summary>Nullable because several callers hold a player through an optional navigation
    /// property; nothing is rendered when it has not been loaded.</summary>
    [Parameter, EditorRequired]
    public Player? Player { get; set; }
}
