@inherits CancellableComponent

@if (_state is not VibrationState.Unsupported)
{
    <div class="notify-row">
        <MudIcon Icon="@(_state is VibrationState.Off ? Icons.Material.Filled.MobileOff : Icons.Material.Filled.Vibration)"
                 Class="notify-icon" />
        <div class="notify-body">
            <div class="notify-title">@L["Vibrate on match events"]</div>
            <div class="notify-text">
                @(_state switch
                {
                    VibrationState.On => L["On in this browser: a buzz at kick-off, at every goal and at full time."],
                    VibrationState.Off => L["Off in this browser. Match notifications, if on, arrive without sound or vibration."],
                    _ => L["An iPhone or iPad decides this itself: turn sounds for this app on or off under Settings → Notifications."],
                })
            </div>
        </div>
        @if (_state is not VibrationState.Ios)
        {
            <MudButton Variant="@(On ? Variant.Text : Variant.Filled)" Color="Color.Primary" Class="notify-button"
                       OnClick="Toggle">
                @(On ? L["Turn off"] : L["Turn on"])
            </MudButton>
        }
    </div>
}
