@inherits CancellableComponent

@if (_on is { } on)
{
    <div class="notify-row">
        <MudIcon Icon="@(on ? Icons.Material.Filled.Vibration : Icons.Material.Filled.MobileOff)" Class="notify-icon" />
        <div class="notify-body">
            <div class="notify-title">@L["Vibrate on match events"]</div>
            <div class="notify-text">
                @(on
                    ? L["On in this browser: a buzz at kick-off, at every goal and at full time."]
                    : L["Off in this browser. Match notifications, if on, arrive without sound or vibration."])
            </div>
        </div>
        <MudButton Variant="@(on ? Variant.Text : Variant.Filled)" Color="Color.Primary" Class="notify-button"
                   OnClick="Toggle">
            @(on ? L["Turn off"] : L["Turn on"])
        </MudButton>
    </div>
}
