@inject IStringLocalizer<Strings> L

@Links(NavGroup.Primary)

@if (ShowIcons)
{
    @* The drawer parks the administration entries at its foot; the app bar has one row and keeps them in line. Never empty: settings is
       open to everyone, so the rule above the group always has something under it. *@
    <div class="nav-group-admin">
        @Links(NavGroup.Administration)
    </div>
}
else
{
    @Links(NavGroup.Administration)
}

@code {
    private RenderFragment Links(NavGroup group) => __builder =>
    {
        foreach (var item in AppNav.Menu.Where(i => i.Group == group))
        {
            @* A RenderFragment local so the MudNavLink is written once and the AuthorizeView only wraps
               the entries that need it — the codebase's one sanctioned use of markup in @code. *@
            RenderFragment link =
                @<MudNavLink Href="@item.Path" Match="@item.Match"
                             Class="@(ShowIcons ? null : "topbar-nav-link")"
                             Icon="@(ShowIcons ? item.Icon : null)">@L[item.LabelKey]</MudNavLink>;

            if (item.RequiresRole is not null)
            {
                <AuthorizeView Roles="@item.RequiresRole">@link</AuthorizeView>
            }
            else
            {
                @link
            }
        }
    };
}
