@inject IStringLocalizer<Strings> L

<MudPaper Class="pa-3" Elevation="2"
          @ondragover:preventDefault="true"
          @ondrop="() => OnPlayerDroppedToSub.InvokeAsync()"
          @onclick="OnBenchClicked">
    <MudText Typo="Typo.subtitle2" GutterBottom="true">@L["Substitutes"]</MudText>

    @{
        var subs = Lineup.Where(p => p.IsSubstitute).ToList();
    }

    @* Mid-drag, empty bench only: with subs listed the zone would just push them down under the cursor. A tap has no cursor to dodge. *@
    @if (!ReadOnly && (DraggedPlayerId is not null && subs.Count == 0
                       || SelectedPlayerId is { } selected && subs.All(s => s.PlayerId != selected)))
    {
        <div class="sub-drop-zone">
            <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Size="Size.Small" />
            <MudText Typo="Typo.caption">@L["Tap or drop here to add as sub"]</MudText>
        </div>
    }

    @if (subs.Count > 0)
    {
        <div class="sub-list">
            @foreach (var sub in subs)
            {
                <div class="sub-item d-flex align-center justify-space-between @(sub.PlayerId == SelectedPlayerId ? "selected" : "")"
                     draggable="@((!ReadOnly).ToString().ToLowerInvariant())"
                     @ondragstart="() => OnSubDragStart.InvokeAsync(sub.PlayerId)"
                     @ondragstart:stopPropagation="true"
                     @ondragover:preventDefault="true"
                     @ondrop="() => OnSwapWithSub.InvokeAsync(sub.PlayerId)"
                     @ondrop:stopPropagation="true"
                     @onclick="() => OnSubClicked(sub.PlayerId)"
                     @onclick:stopPropagation="true"
                     style="cursor: @(ReadOnly ? "default" : "grab"); padding: 4px 8px;">
                    <div>
                        <MudText Typo="Typo.body2">
                            <PlayerLabel Player="sub.Player" />
                        </MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @sub.Position.ToString()
                        </MudText>
                    </div>
                    @if (!ReadOnly)
                    {
                        <span @onclick:stopPropagation="true">
                            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                           OnClick="() => OnSubRemoved.InvokeAsync(sub)" />
                        </span>
                    }
                </div>
            }
        </div>
    }
    else if (DraggedPlayerId is null && !ReadOnly)
    {
        <MudText Typo="Typo.caption" Color="Color.Tertiary">@L["Drag or tap players here to add as subs"]</MudText>
    }
</MudPaper>
