@inject IStringLocalizer<Strings> L

<MudPaper Class="pa-2" Elevation="2">
    <MudText Typo="Typo.subtitle2" Class="mb-2">@L["Available Players"]</MudText>

    @if (Players.Count == 0)
    {
        <MudText Typo="Typo.caption" Color="Color.Tertiary">@L["All players assigned"]</MudText>
    }

    <div class="player-grid">
        @foreach (var player in Players)
        {
            <div class="draggable-player"
                 draggable="@((!ReadOnly).ToString().ToLowerInvariant())"
                 @ondragstart="() => OnDragStart.InvokeAsync(player.Id)">
                <span class="player-shirt">@(player.ShirtNumber?.ToString() ?? "-")</span>
                <div class="player-info">
                    <span class="player-name-text">@player.DisplayName</span>
                    <span class="player-pos-text">@player.PreferredPosition.ToString()</span>
                </div>
            </div>
        }
    </div>
</MudPaper>
