@inject NavigationManager Navigation

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    // Signed in but refused is an admin looking at a team they do not run (see TeamScopedAdminRole); signing in again would not help them.
    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null && (await AuthState).User.Identity?.IsAuthenticated == true)
        {
            Navigation.NavigateTo(AppRoutes.Home, forceLoad: true);
            return;
        }

        Navigation.NavigateTo($"{AppRoutes.Login}?returnUrl={Uri.EscapeDataString(Navigation.Uri)}", forceLoad: true);
    }
}
