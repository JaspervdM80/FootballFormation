@namespace FootballFormation.UI.Components
@inject IStringLocalizer<Strings> L

@* Rendered hidden and handed to js/pwa.js, which unhides it and wires the buttons. Everything the
   decision needs — display-mode, the user agent, a dismissal in localStorage, and whether Chrome
   ever offered a native prompt — is known only to the browser, and this markup renders on pages
   with no circuit to ask it over. The strings are still localized here, because the resx is the
   server's. *@
<div id="install-banner" class="install-banner" hidden
     data-instruction-ios="@L["Tap Share, then \"Add to Home Screen\"."]"
     data-instruction-android="@L["In the browser menu (⋮), tap \"Add to Home screen\"."]">
    @* 44px hit area around a small cross: it reads as a corner dismiss, but a thumb still finds it. *@
    <button type="button" class="install-banner-close" data-install-dismiss aria-label="@L["Close"]">
        <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
    </button>
    <div class="install-banner-body">
        <MudIcon Icon="@Icons.Material.Filled.InstallMobile" Color="Color.Primary" />
        <div style="min-width: 0;">
            <MudText Typo="Typo.subtitle2">@L["Install GJS meiden app"]</MudText>
            <MudText Typo="Typo.caption" data-install-instruction>@L["Add the app to your home screen."]</MudText>
        </div>
    </div>
    <div class="install-banner-actions" hidden>
        <button type="button" class="install-banner-install" data-install-prompt>@L["Install"]</button>
    </div>
</div>
