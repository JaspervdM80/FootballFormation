@namespace FootballFormation.UI.Components

@if (Visible)
{
    <MudPaper Elevation="8" Class="pa-3"
              Style="position: fixed; bottom: calc(12px + env(safe-area-inset-bottom, 0px)); left: 12px; right: 12px; z-index: 1390; border-radius: 12px; max-width: 480px; margin: 0 auto;">
        @* 44px hit area around a small cross: it reads as a corner dismiss, but a thumb still finds it. *@
        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="DismissAsync"
                       aria-label="@L["Close"]"
                       Style="position: absolute; top: 2px; right: 2px; width: 44px; height: 44px;" />
        <div class="d-flex align-center gap-3" style="padding-right: 44px;">
            <MudIcon Icon="@Icons.Material.Filled.InstallMobile" Color="Color.Primary" />
            <div style="min-width: 0;">
                <MudText Typo="Typo.subtitle2">@L["Install GJS meiden app"]</MudText>
                <MudText Typo="Typo.caption" Style="opacity: 0.8;">@L[Instruction]</MudText>
            </div>
        </div>
        @if (ShowInstallButton)
        {
            <div class="d-flex justify-end mt-3">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                           Style="min-height: 31px; height: 31px; padding-top: 0; padding-bottom: 0;"
                           OnClick="InstallAsync">@L["Install"]</MudButton>
            </div>
        }
    </MudPaper>
}
