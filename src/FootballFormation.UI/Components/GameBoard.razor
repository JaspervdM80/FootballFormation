@inherits SeasonAwarePage

@if (Interactive)
{
    <InteractiveShell />
}

<PageHeader Class="mb-6" Title="@L["Games"]">
    <SubtitleContent>
        <MudText Typo="Typo.body2" Class="page-header-subtitle">
            @if (_games is not null)
            {
                @(_games.Count == 1 ? L["{0} match", _games.Count] : L["{0} matches", _games.Count])
                @if (SeasonState.SelectedSeason is { } season)
                {
                    <span> · @season.Name</span>
                }
                var incomplete = _games.Count(IsIncomplete);
                if (incomplete > 0)
                {
                    <span class="header-warning"> · @L["{0} without lineup", incomplete]</span>
                }
            }
        </MudText>
    </SubtitleContent>
    <Actions>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Class="btn-compact" StartIcon="@Icons.Material.Filled.Assignment"
                   Href="@AppRoutes.DutiesFromNextGame" title="@L["Duties"]" aria-label="@L["Duties"]">
            @L["Duties"]
        </MudButton>
        <AuthorizeView Roles="@AppRoles.Admin">
            <MudButton Variant="Variant.Filled" Class="btn-gold btn-compact" StartIcon="@Icons.Material.Filled.Add"
                       OnClick="OpenAddDialog">
                @L["Add"]
            </MudButton>
        </AuthorizeView>
    </Actions>
</PageHeader>

<InlineNotice Notice="_notice" />

@if (_games is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_games.Count == 0)
{
    <MudPaper Class="pa-6" Elevation="2" Style="border-radius: 16px; text-align: center;">
        <MudIcon Icon="@Icons.Material.Filled.SportsSoccer" Size="Size.Large" Style="color: var(--ink-faint);" />
        <MudText Typo="Typo.body1" Class="mt-3" Style="color: var(--ink-muted);">
            @(SeasonState.SelectedSeason is { } season
                ? L["No games in {0} yet.", season.Name]
                : L["No games yet. Create your first game!"])
        </MudText>
    </MudPaper>
}
else
{
    @foreach (var gameList in Sections())
    {
        <div class="game-section">
            <div class="card-label">@gameList.Title</div>
            <div class="game-cards">
                @foreach (var game in gameList.Games)
                {
                    var rowClass = IsIncomplete(game) ? "no-lineup" : "";
                    var primary = PrimaryAction(game);
                    <div class="game-row @rowClass">
                        @* The whole card is the link, laid under the actions rather than around them, so no anchor nests in another. *@
                        <a class="game-open" href="@OpenUrl(game)" aria-label="@game.Opponent"></a>
                        <DateBlock Date="game.Date" Class="game-date" />
                        <div class="game-primary">
                            <span class="game-opponent">@game.Opponent</span>
                            <div class="game-meta">
                                <VenueBadge IsHome="game.IsHomeGame" />
                                @if (game.HasStartTime)
                                {
                                    <span class="game-time">@game.Date.ToString("HH:mm")</span>
                                }
                                @* A cup tie or a practice game changes what the row means; a competition match is the norm and says nothing. *@
                                @if (game.MatchType != MatchType.Competition)
                                {
                                    <span class="badge-teal">@L[game.MatchType.DisplayName()]</span>
                                }
                                @{
                                    var missing = game.UnavailablePlayerIds.Union(game.InjuredPlayerIds).Count();
                                }
                                @if (missing > 0)
                                {
                                    <span class="badge-unavailable">@L["{0} out", missing]</span>
                                }
                                @if (game.GuestPlayerIds.Count > 0)
                                {
                                    <span class="badge-guest">@L["+{0} guest", game.GuestPlayerIds.Count]</span>
                                }
                                @if (IsIncomplete(game))
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.WarningAmber" Size="Size.Small" Class="nolineup-icon"
                                             Title="@L["This game has no lineup — playing time can't be recorded"]" />
                                }
                            </div>
                        </div>
                        @if (game.ScoreHome.HasValue && game.ScoreAway.HasValue)
                        {
                            var scoreClass = game.ScoreHome > game.ScoreAway ? "win" : game.ScoreHome < game.ScoreAway ? "loss" : "draw";
                            <span class="game-score @scoreClass">@game.ScoreboardOrder()</span>
                        }
                        <div class="game-actions">
                            @if (primary == RowAction.Live)
                            {
                                <a class="action-btn action-labelled action-live @(game.MatchState == MatchState.InProgress ? "action-live-now" : "")"
                                   title="@L["Live"]" href="@AppRoutes.Live(game.Id)">
                                    @L["Live"]
                                </a>
                            }
                            else if (primary == RowAction.Formation)
                            {
                                <a class="action-btn action-labelled @(IsIncomplete(game) ? "action-needs-lineup" : "")"
                                   title="@(IsIncomplete(game) ? L["Add lineup"] : L["Formation"])" href="@AppRoutes.Formation(game.Id)">
                                    @L["Formation"]
                                </a>
                            }
                            @if (Interactive)
                            {
                                <MudMenu Class="game-more" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="true">
                                    @* A custom activator so the button keeps its label; MudBlazor wires no click to it — see docs/ui_components/mudblazor-notes.md. *@
                                    <ActivatorContent Context="menu">
                                        <MudIconButton Icon="@Icons.Material.Filled.MoreVert" aria-label="@L["More actions"]" title="@L["More actions"]"
                                                       OnClick="menu.ToggleAsync" />
                                    </ActivatorContent>
                                    <ChildContent>
                                    @if (_isAdmin && primary != RowAction.Formation)
                                    {
                                        <MudMenuItem Icon="@Icons.Material.Filled.ViewModule" Href="@AppRoutes.Formation(game.Id)">
                                            @(IsIncomplete(game) ? L["Add lineup"] : L["Formation"])
                                        </MudMenuItem>
                                    }
                                    <MudMenuItem Icon="@Icons.Material.Filled.Share" Href="@AppRoutes.Overview(game.Id)">@L["Overview"]</MudMenuItem>
                                    @* A match still to be played has no result to look at and none to enter. *@
                                    @if (!IsFuture(game))
                                    {
                                        <MudMenuItem Icon="@Icons.Material.Filled.Scoreboard" Href="@AppRoutes.Result(game.Id)">@L["Result"]</MudMenuItem>
                                    }
                                    @if (_isAdmin)
                                    {
                                        <MudMenuItem Icon="@Icons.Material.Filled.Edit" OnClick="() => AfterMenuCloses(() => OpenEditDialog(game))">@L["Edit"]</MudMenuItem>
                                        <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error" OnClick="() => AfterMenuCloses(() => DeleteGame(game))">@L["Delete"]</MudMenuItem>
                                    }
                                    </ChildContent>
                                </MudMenu>
                            }
                            else
                            {
                                @* A visitor's menu holds links only, so it needs no circuit — the same disclosure as the season picker. *@
                                <details class="game-more game-more-static">
                                    <summary aria-label="@L["More actions"]" title="@L["More actions"]">
                                        <MudIcon Icon="@Icons.Material.Filled.MoreVert" />
                                    </summary>
                                    <div class="disclosure-menu">
                                        <a class="game-more-item disclosure-menu-item" href="@AppRoutes.Overview(game.Id)">
                                            <MudIcon Icon="@Icons.Material.Filled.Share" Size="Size.Small" />
                                            @L["Overview"]
                                        </a>
                                        @if (!IsFuture(game))
                                        {
                                            <a class="game-more-item disclosure-menu-item" href="@AppRoutes.Result(game.Id)">
                                                <MudIcon Icon="@Icons.Material.Filled.Scoreboard" Size="Size.Small" />
                                                @L["Result"]
                                            </a>
                                        }
                                    </div>
                                </details>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }
}

@if (_teamId is { } teamId)
{
    <CalendarSubscribe TeamId="teamId" />
}
