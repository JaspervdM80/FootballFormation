@inherits LayoutComponentBase
@inject IStringLocalizer<Strings> L

<MudThemeProvider Theme="Theme" IsDarkMode="false" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Fixed="true" Dense="true" Style="background: var(--gradient-appbar); border-bottom: 1px solid color-mix(in srgb, var(--ink) 5%, transparent); padding-top: env(safe-area-inset-top, 0px);">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Class="nav-hamburger" Edge="Edge.Start"
                       Style="color: color-mix(in srgb, var(--ink) 80%, transparent);" OnClick="ToggleDrawer" aria-label="Menu" />
        @* The title is the home link — which is why the menu has no Start item, in either rendering *@
        <a href="@AppRoutes.Home" class="app-title-link ml-2 mr-8" aria-label="@L["Start"]">
            <span class="app-title-logo" aria-hidden="true"></span>
            <span class="app-title-text">GJS Meiden</span>
        </a>
        <div class="d-flex gap-1 topbar-nav">
            <NavItems />
        </div>
        <MudSpacer />
        <SeasonPicker Compact="true" />
        <MudMenu Icon="@Icons.Material.Filled.Language" Size="Size.Small" Dense="true"
                 AriaLabel="Language" Style="color: color-mix(in srgb, var(--ink) 50%, transparent);">
            <MudMenuItem OnClick="@(() => SwitchCulture("nl"))">Nederlands</MudMenuItem>
            <MudMenuItem OnClick="@(() => SwitchCulture("en"))">English</MudMenuItem>
        </MudMenu>
        <AuthorizeView Roles="@AppRoles.Admin">
            <Authorized>
                <div class="d-flex align-center gap-2">
                    <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" Size="Size.Small" Style="color: var(--club-primary-bright);" />
                    <MudText Typo="Typo.body2" Class="admin-name" Style="color: color-mix(in srgb, var(--ink) 60%, transparent);">@context.User.DisplayName()</MudText>
                    <form method="post" action="/auth/logout" data-enhance="false" style="margin: 0;">
                        <button type="submit"
                                style="background: none; border: none; color: color-mix(in srgb, var(--ink) 40%, transparent); cursor: pointer; font-size: 0.875rem; padding: 4px 8px; text-transform: none;">
                            @L["Logout"]
                        </button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                <MudButton Href="@AppRoutes.Login" Target="_self" Variant="Variant.Text" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Lock"
                           Style="color: color-mix(in srgb, var(--ink) 40%, transparent); text-transform: none;">
                    Admin
                </MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Variant="@DrawerVariant.Temporary" Elevation="2"
               Style="padding-top: env(safe-area-inset-top, 0px);">
        <a href="@AppRoutes.Home" class="app-title-link pa-4" aria-label="@L["Start"]">
            <span class="app-title-logo" aria-hidden="true"></span>
            <span class="app-title-text">GJS Meiden</span>
        </a>
        <div class="drawer-season-picker">
            <SeasonPicker />
        </div>
        <MudNavMenu>
            <NavItems ShowIcons="true" />
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent Style="padding: calc(76px + env(safe-area-inset-top, 0px)) 24px calc(40px + env(safe-area-inset-bottom, 0px)); max-width: 1100px; margin: 0 auto;">
        @Body
    </MudMainContent>

    <InstallBanner />
</MudLayout>
