@inherits LayoutComponentBase
@inject IStringLocalizer<Strings> L

<MudThemeProvider Theme="Theme" IsDarkMode="false" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    @* The drawer's open state is this checkbox, not component state: the layout renders statically
       on every page, so there is no circuit here to hold a bool or to handle a click. It is first
       because app.css reaches the drawer and the scrim from it with a sibling combinator, and it
       stays focusable — visually hidden, but the control a keyboard or screen reader gets. The two
       labels are the visual affordances and carry no semantics of their own. *@
    <input type="checkbox" id="nav-drawer" class="nav-drawer-toggle" aria-label="@L["Menu"]" />

    <MudAppBar Elevation="0" Fixed="true" Dense="true" Style="background: var(--gradient-appbar); border-bottom: 1px solid color-mix(in srgb, var(--ink) 5%, transparent); padding-top: env(safe-area-inset-top, 0px);">
        <label for="nav-drawer" class="nav-hamburger" aria-hidden="true">
            <MudIcon Icon="@Icons.Material.Filled.Menu" />
        </label>
        @* The title is the home link — which is why the menu has no Start item, in either rendering *@
        <a href="@AppRoutes.Home" class="app-title-link ml-2 mr-8" aria-label="@L["Start"]">
            <span class="app-title-logo" aria-hidden="true"></span>
            <span class="app-title-text">GJS Meiden</span>
        </a>
        <div class="d-flex gap-1 topbar-nav">
            <NavItems />
        </div>
        <MudSpacer />
        <SeasonPicker Compact="true" />
        @* Same reasoning as the season picker: a disclosure of plain links, because MudMenu needs a
           popover provider and a circuit, and this layout has neither. *@
        <details class="language-picker">
            <summary aria-label="@L["Language"]">
                <MudIcon Icon="@Icons.Material.Filled.Language" Size="Size.Small" />
            </summary>
            <div class="language-picker-menu">
                <a href="@CultureUrl("nl")">Nederlands</a>
                <a href="@CultureUrl("en")">English</a>
            </div>
        </details>
        <AuthorizeView Roles="@AppRoles.Admin">
            <Authorized>
                <div class="d-flex align-center gap-2">
                    <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" Size="Size.Small" Style="color: var(--club-primary-bright);" />
                    <MudText Typo="Typo.body2" Class="admin-name" Style="color: var(--ink-muted);">@context.User.DisplayName()</MudText>
                    <form method="post" action="/auth/logout" data-enhance="false" style="margin: 0;">
                        <button type="submit"
                                style="background: none; border: none; color: var(--ink-subtle); cursor: pointer; font-size: 0.875rem; padding: 4px 8px; text-transform: none;">
                            @L["Logout"]
                        </button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                <MudButton Href="@AppRoutes.Login" Target="_self" Variant="Variant.Text" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Lock"
                           Style="color: var(--ink-subtle); text-transform: none;">
                    @L["Admin"]
                </MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>

    @* Dismisses the drawer by tapping outside it — the label is the checkbox's second control. *@
    <label for="nav-drawer" class="drawer-scrim" aria-hidden="true"></label>

    <aside class="app-drawer" style="padding-top: env(safe-area-inset-top, 0px);">
        <a href="@AppRoutes.Home" class="app-title-link pa-4" aria-label="@L["Start"]">
            <span class="app-title-logo" aria-hidden="true"></span>
            <span class="app-title-text">GJS Meiden</span>
        </a>
        <div class="drawer-season-picker">
            <SeasonPicker />
        </div>
        <MudNavMenu>
            <NavItems ShowIcons="true" />
        </MudNavMenu>
    </aside>

    @* Horizontal padding is a clamp rather than a flat 24px: a 320px phone kept only 272px of
       content. The left/right safe-area insets matter too — viewport-fit=cover means landscape on
       a notched phone would otherwise run content under the notch and the rounded corners. *@
    <MudMainContent Class="app-main" Style="max-width: 1100px; margin: 0 auto;">
        @Body
    </MudMainContent>

    <InstallBanner />
</MudLayout>
