# Database files and their backups. This repository is public and the database holds the names
# and shirt numbers of children — a copy pulled off the volume for a restore must never be one
# `git add -A` away from being published. Keep them outside the repo, or here but ignored.
backups/
*.db
*.db-shm
*.db-wal

# Publish output
publish/
out/

# Node tooling for scripts/ — not part of the app build
scripts/node_modules/
scripts/package-lock.json

# Playwright UI tests. The signed-in browser states under .auth/ are credentials for the throwaway
# database a run creates, and everything else here is a run's own output.
tests/ui/node_modules/
tests/ui/package-lock.json
tests/ui/.auth/
tests/ui/test-results/
tests/ui/playwright-report/

# Claude Code. The session-start hook and the settings that register it are shared, because a web
# session with no .NET SDK cannot build or test this app at all. Personal overrides stay local.
.claude/*
!.claude/hooks/
!.claude/settings.json
.claude/settings.local.json
